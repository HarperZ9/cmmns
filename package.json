{
  "name": "daylight-commons",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core/api.js",
    "./core": "./src/core/api.js",
    "./imports": "./src/core/imports.js",
    "./bundle": "./src/core/evidence-bundle.js",
    "./schema/evidence.v1.json": "./schema/evidence.v1.json"
  },
  "bin": {
    "daylight": "bin/radar.mjs",
    "daylight-commons": "bin/radar.mjs",
    "radar": "bin/radar.mjs"
  },
  "description": "Evidence badges for social media replies: where an account is based, coordination signs, and a thread norm report.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "data:check": "node scripts/data-lock.mjs check",
    "data:guard": "node scripts/upstream-guard.mjs",
    "pack": "node scripts/pack.mjs",
    "pages": "node scripts/transparency.mjs && node scripts/privacy.mjs && node scripts/install-page.mjs && node scripts/how-it-works.mjs && node scripts/catalogue-page.mjs",
    "package": "node scripts/package.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:persuasion": "node scripts/eval-persuasion.mjs",
    "ci": "node scripts/ci.mjs test",
    "release": "node scripts/release.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "catalogue:refetch": "node scripts/catalogue-refetch.mjs --quotes"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "browser-extension",
    "fact-checking",
    "misinformation",
    "disinformation",
    "media-literacy",
    "social-media",
    "coordinated-inauthentic-behavior",
    "provenance",
    "firefox-extension",
    "chrome-extension"
  ],
  "homepage": "https://harperz9.github.io/daylight-commons/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarperZ9/daylight-commons.git"
  },
  "bugs": {
    "url": "https://github.com/HarperZ9/daylight-commons/issues"
  }
}
