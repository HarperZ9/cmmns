// Wave 88A (Slice 15: F1/AC1/N53/N49): Pure-BuildLang Zero-C End-to-End Encrypted Handshake
// (tls_mini_handshake_zeroc.bld): X25519 ECDH + RFC 5869 HKDF-SHA256 + RFC 8439 ChaCha20-Poly1305.
// Compiled with ZERO C compiler, ZERO Rust, ZERO linker via buildc_selfhost_crypto.bld across
// ALL FIVE zero-C targets (x64-pe, x64-elf, rv64-elf, aarch64-elf, wasm).
//
// Modes:
//   0 = Clean Alice <-> Bob handshake (status=1, auth_ok=1, pt_match=1)
//   1 = Planted control (a): MITM 1-bit transcript tamper -> Bob derives wrong HKDF key (auth_ok=0)
//   2 = Planted control (b): 1-bit ciphertext flip in transit -> Poly1305 tag rejects (auth_ok=0)
//   3 = Planted control (c): Low-order all-zero peer key -> rejected BEFORE HKDF (status=-301)

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

fn tls_handshake_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let m26: i64 = 67108863;

    // Shared 130-word work pool (1,040 B) + compact arrays (1,632 B total; frame < 1,950 B < 2,048 B)
    let mut fe: [i64; 130] = [0; 130];
    let mut acc: [i64; 10] = [0; 10];
    let mut sk: [i64; 8] = [0; 8];
    let mut u_in: [i64; 8] = [0; 8];
    let mut vault: [i64; 48] = [0; 48];

    // Compact shared scalar pool (reused across Stages 1, 2, and 3 so RV64 frame < 2,048 B)
    let mut i: i64 = 0; let mut j: i64 = 0; let mut k: i64 = 0; let mut cp: i64 = 0;
    let mut p0: i64 = 0; let mut p1: i64 = 0; let mut p2: i64 = 0; let mut p3: i64 = 0;
    let mut q0: i64 = 0; let mut q1: i64 = 0; let mut q2: i64 = 0; let mut q3: i64 = 0;
    let mut h0: i64 = 0; let mut h1: i64 = 0; let mut h2: i64 = 0; let mut h3: i64 = 0;
    let mut h4: i64 = 0; let mut h5: i64 = 0; let mut h6: i64 = 0; let mut h7: i64 = 0;
    let mut a: i64 = 0;  let mut b: i64 = 0;  let mut c: i64 = 0;  let mut d: i64 = 0;
    let mut e: i64 = 0;  let mut f: i64 = 0;  let mut g: i64 = 0;  let mut hh: i64 = 0;

    // =========================================================================
    // STAGE 1: RFC 7748 X25519 ECDH (p0=run_id, p1=ss_nz, p2=ecdh_eq)
    // =========================================================================
    p0 = 0; p1 = 0; p2 = 1;
    while p0 < 4 {
        if p0 == 0 || p0 == 2 {
            sk[0] = 174917495;  sk[1] = 2107971699; sk[2] = 1925256764; sk[3] = 1164358225;
            sk[4] = 2268024031; sk[5] = 714719467;  sk[6] = 2784720817; sk[7] = 707574045;
        } else {
            sk[0] = 2114497373; sk[1] = 1267354210; sk[2] = 2340413817; sk[3] = 3859710083;
            sk[4] = 699480943;  sk[5] = 4256569382; sk[6] = 663432988;  sk[7] = 3957360895;
        }
        sk[0] = sk[0] & 4294967288;
        sk[7] = (sk[7] & 2147483647) | 1073741824;

        i = 0;
        while i < 8 {
            if p0 == 2 && mode != 3 { u_in[i] = vault[8 + i]; }
            else if p0 == 3 && mode != 3 { u_in[i] = vault[i]; }
            else { u_in[i] = 0; }
            i = i + 1;
        }
        if p0 == 0 || p0 == 1 { u_in[0] = 9; }
        u_in[7] = u_in[7] & 2147483647;

        i = 0;
        while i < 130 { fe[i] = 0; i = i + 1; }

        q0 = 0; i = 0;
        while i < 10 {
            a = 26; if (i & 1) != 0 { a = 25; }
            b = q0 >> 5; c = q0 & 31;
            d = u_in[b] >> c;
            if c + a > 32 && b + 1 < 8 { d = d | (u_in[b + 1] << (32 - c)); }
            d = d & ((1 << a) - 1);
            fe[i] = d; fe[30 + i] = d;
            q0 = q0 + a; i = i + 1;
        }
        fe[10] = 1; fe[40] = 1;

        // q0=swap, q1=phase, q2=step, q3=op, p3=op_end
        q0 = 0; q1 = 0; q2 = 254;
        while q1 < 2 {
            q3 = 0; p3 = 18;
            if q1 == 0 {
                a = 0; if q2 >= 0 { a = (sk[q2 >> 5] >> (q2 & 31)) & 1; }
                q0 = q0 ^ a; b = 0 - q0;
                i = 0;
                while i < 10 {
                    c = b & (fe[10 + i] ^ fe[30 + i]);
                    fe[10 + i] = fe[10 + i] ^ c; fe[30 + i] = fe[30 + i] ^ c;
                    d = b & (fe[20 + i] ^ fe[40 + i]);
                    fe[20 + i] = fe[20 + i] ^ d; fe[40 + i] = fe[40 + i] ^ d;
                    i = i + 1;
                }
                q0 = a; if q2 < 0 { p3 = 0; }
            } else {
                q3 = 18; p3 = 20; if q2 == 255 { q3 = 20; p3 = 21; }
            }

            while q3 < p3 {
                a = 0;
                if q3 == 0 { a = 5394; } else if q3 == 1 { a = 9746; } else if q3 == 2 { a = 14165; }
                else if q3 == 3 { a = 14438; } else if q3 == 4 { a = 10616; } else if q3 == 5 { a = 6708; }
                else if q3 == 6 { a = 11060; } else if q3 == 7 { a = 15541; } else if q3 == 8 { a = 15014; }
                else if q3 == 9 { a = 5066; } else if q3 == 10 { a = 9418; } else if q3 == 11 { a = 13107; }
                else if q3 == 12 { a = 13380; } else if q3 == 13 { a = 13316; } else if q3 == 14 { a = 12664; }
                else if q3 == 15 { a = 19600; } else if q3 == 16 { a = 7292; } else if q3 == 17 { a = 12956; }
                else if q3 == 18 { if q2 != 2 && q2 != 4 { a = 15019; } }
                else if q3 == 19 { a = 15291; } else { a = 12570; }

                if a != 0 {
                    b = a >> 12; c = ((a >> 8) & 15) * 10; d = ((a >> 4) & 15) * 10; e = (a & 15) * 10;
                    if b == 1 || b == 2 || b == 4 {
                        k = 0;
                        while k < 10 {
                            if b == 1 { acc[k] = fe[d + k] + fe[e + k]; }
                            else if b == 2 { acc[k] = fe[d + k] - fe[e + k]; }
                            else { acc[k] = fe[d + k] * 121665; }
                            k = k + 1;
                        }
                    } else {
                        k = 0; while k < 10 { acc[k] = 0; k = k + 1; }
                        i = 0;
                        while i < 10 {
                            f = fe[d + i]; g = i & 1; j = 0;
                            while j < 10 {
                                k = i + j; hh = 1;
                                if g != 0 && (j & 1) != 0 { hh = 2; }
                                if k >= 10 { k = k - 10; hh = hh * 19; }
                                acc[k] = acc[k] + f * fe[e + j] * hh;
                                j = j + 1;
                            }
                            i = i + 1;
                        }
                    }
                    cp = 0;
                    while cp < 2 {
                        i = 0;
                        while i < 10 {
                            f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                            hh = acc[i] >> f; acc[i] = acc[i] & g;
                            if i < 9 { acc[i + 1] = acc[i + 1] + hh; } else { acc[0] = acc[0] + hh * 19; }
                            i = i + 1;
                        }
                        cp = cp + 1;
                    }
                    i = 0; while i < 10 { fe[c + i] = acc[i]; i = i + 1; }
                }
                q3 = q3 + 1;
            }

            if q1 == 0 {
                if q2 < 0 {
                    i = 0; while i < 10 { fe[100 + i] = 0; fe[110 + i] = fe[20 + i]; i = i + 1; }
                    fe[100] = 1; q1 = 1; q2 = 0;
                } else { q2 = q2 - 1; }
            } else {
                if q2 == 255 { q1 = 2; } else { q2 = q2 + 1; }
            }
        }

        i = 0; while i < 10 { acc[i] = fe[10 + i]; i = i + 1; }
        while acc[9] < 0 {
            acc[0] = acc[0] - 19; acc[9] = acc[9] + 33554432;
            cp = 0;
            while cp < 2 {
                i = 0;
                while i < 10 {
                    f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                    hh = acc[i] >> f; acc[i] = acc[i] & g;
                    if i < 9 { acc[i + 1] = acc[i + 1] + hh; } else { acc[0] = acc[0] + hh * 19; }
                    i = i + 1;
                }
                cp = cp + 1;
            }
        }
        i = 0; while i < 10 { fe[120 + i] = acc[i]; i = i + 1; }
        fe[120] = fe[120] + 19;
        i = 0;
        while i < 9 {
            f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
            hh = fe[120 + i] >> f; fe[120 + i] = fe[120 + i] & g;
            fe[120 + i + 1] = fe[120 + i + 1] + hh; i = i + 1;
        }
        a = fe[129] >> 25; fe[129] = fe[129] & 33554431;
        if a > 0 { i = 0; while i < 10 { acc[i] = fe[120 + i]; i = i + 1; } }

        i = 0; while i < 8 { u_in[i] = 0; i = i + 1; }
        q0 = 0; i = 0;
        while i < 10 {
            a = 26; if (i & 1) != 0 { a = 25; }
            b = q0 >> 5; c = q0 & 31;
            u_in[b] = (u_in[b] | ((acc[i] << c) & m32)) & m32;
            if c + a > 32 && b + 1 < 8 { u_in[b + 1] = (u_in[b + 1] | (acc[i] >> (32 - c))) & m32; }
            q0 = q0 + a; i = i + 1;
        }

        i = 0;
        while i < 8 {
            if p0 < 3 {
                vault[p0 * 8 + i] = u_in[i];
                if p0 == 2 { p1 = p1 | u_in[i]; }
            } else if u_in[i] != vault[16 + i] { p2 = 0; }
            i = i + 1;
        }
        p0 = p0 + 1;
    }

    if p1 == 0 || p2 == 0 {
        println("{}", -301); println("{}", 0); println("{}", 0);
        return -301;
    }

    // =========================================================================
    // STAGE 2: TRANSCRIPT HASH + RFC 5869 HKDF-SHA256 (fe[0..63]=K, fe[64..127]=W)
    // =========================================================================
    fe[0] = 1116352408;  fe[1] = 1899447441;  fe[2] = 3049323471;  fe[3] = 3921009573;
    fe[4] = 961987163;   fe[5] = 1508970993;  fe[6] = 2453635748;  fe[7] = 2870763221;
    fe[8] = 3624381080;  fe[9] = 310598401;   fe[10] = 607225278;  fe[11] = 1426881987;
    fe[12] = 1925078388; fe[13] = 2162078206; fe[14] = 2614888103; fe[15] = 3248222580;
    fe[16] = 3835390401; fe[17] = 4022224774; fe[18] = 264347078;  fe[19] = 604807628;
    fe[20] = 770255983;  fe[21] = 1249150122; fe[22] = 1555081692; fe[23] = 1996064986;
    fe[24] = 2554220882; fe[25] = 2821834349; fe[26] = 2952996808; fe[27] = 3210313671;
    fe[28] = 3336571891; fe[29] = 3584528711; fe[30] = 113926993;  fe[31] = 338241895;
    fe[32] = 666307205;  fe[33] = 773529912;  fe[34] = 1294757372; fe[35] = 1396182291;
    fe[36] = 1695183700; fe[37] = 1986661051; fe[38] = 2177026350; fe[39] = 2456956037;
    fe[40] = 2730485921; fe[41] = 2820302411; fe[42] = 3259730800; fe[43] = 3345764771;
    fe[44] = 3516065817; fe[45] = 3600352804; fe[46] = 4094571909; fe[47] = 275423344;
    fe[48] = 430227734;  fe[49] = 506948616;  fe[50] = 659060556;  fe[51] = 883997877;
    fe[52] = 958139571;  fe[53] = 1322822218; fe[54] = 1537002063; fe[55] = 1747873779;
    fe[56] = 1955562222; fe[57] = 2024104815; fe[58] = 2227730452; fe[59] = 2361852424;
    fe[60] = 2428436474; fe[61] = 2756734187; fe[62] = 3204031479; fe[63] = 3329325298;

    i = 0; while i < 24 { vault[i] = bswap32(vault[i]); i = i + 1; }

    // p0=party (0=Alice, 1=Bob), p1=job (0..6), p2=nblks, p3=blk
    p0 = 0;
    while p0 < 2 {
        p1 = 0;
        while p1 < 7 {
            h0 = 1779033703; h1 = 3144134277; h2 = 1013904242; h3 = 2773480762;
            h4 = 1359893119; h5 = 2600822924; h6 = 528734635;  h7 = 1541459225;
            p2 = 2; if p1 == 5 { p2 = 3; }
            p3 = 0;
            while p3 < p2 {
                i = 0; while i < 16 { fe[64 + i] = 0; i = i + 1; }
                if p1 == 0 {
                    if p3 == 0 {
                        i = 0; while i < 16 { fe[64 + i] = vault[i]; i = i + 1; }
                        if mode == 1 && p0 == 1 { fe[72] = fe[72] ^ 1; }
                    } else { fe[64] = 2147483648; fe[79] = 512; }
                } else {
                    q0 = 909522486; if p1 == 2 || p1 == 4 || p1 == 6 { q0 = 1549556828; }
                    q1 = 32; if p1 == 1 || p1 == 2 { q1 = 24; }
                    if p3 == 0 {
                        i = 0; while i < 8 { fe[64 + i] = vault[q1 + i] ^ q0; i = i + 1; }
                        while i < 16 { fe[64 + i] = q0; i = i + 1; }
                    } else if p1 == 1 {
                        i = 0; while i < 8 { fe[64 + i] = vault[16 + i]; i = i + 1; }
                        fe[72] = 2147483648; fe[79] = 768;
                    } else if p1 == 2 || p1 == 4 || p1 == 6 {
                        i = 0; while i < 8 { fe[64 + i] = vault[40 + i]; i = i + 1; }
                        fe[72] = 2147483648; fe[79] = 768;
                    } else if p1 == 3 {
                        i = 0; while i < 8 { fe[64 + i] = vault[24 + i]; i = i + 1; }
                        fe[72] = 25165824; fe[79] = 776;
                    } else if p3 == 1 {
                        i = 0;
                        while i < 8 {
                            if p0 == 0 { fe[64 + i] = bswap32(sk[i]); } else { fe[64 + i] = bswap32(u_in[i]); }
                            fe[72 + i] = vault[24 + i]; i = i + 1;
                        }
                    } else { fe[64] = 41943040; fe[79] = 1032; }
                }

                i = 16;
                while i < 64 {
                    q0 = fe[64 + i - 15]; q1 = rotr32(q0, 7) ^ rotr32(q0, 18) ^ (q0 >> 3);
                    q2 = fe[64 + i - 2];  q3 = rotr32(q2, 17) ^ rotr32(q2, 19) ^ (q2 >> 10);
                    fe[64 + i] = (fe[64 + i - 16] + q1 + fe[64 + i - 7] + q3) & m32;
                    i = i + 1;
                }
                a = h0; b = h1; c = h2; d = h3; e = h4; f = h5; g = h6; hh = h7;
                i = 0;
                while i < 64 {
                    q0 = (hh + (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) + ((e & f) ^ ((e ^ m32) & g)) + fe[i] + fe[64 + i]) & m32;
                    q1 = ((rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                    hh = g; g = f; f = e; e = (d + q0) & m32;
                    d = c; c = b; b = a; a = (q0 + q1) & m32;
                    i = i + 1;
                }
                h0 = (h0 + a) & m32; h1 = (h1 + b) & m32; h2 = (h2 + c) & m32; h3 = (h3 + d) & m32;
                h4 = (h4 + e) & m32; h5 = (h5 + f) & m32; h6 = (h6 + g) & m32; h7 = (h7 + hh) & m32;
                p3 = p3 + 1;
            }

            if p1 == 0 {
                vault[24] = h0; vault[25] = h1; vault[26] = h2; vault[27] = h3;
                vault[28] = h4; vault[29] = h5; vault[30] = h6; vault[31] = h7;
            } else if p1 == 2 {
                vault[32] = h0; vault[33] = h1; vault[34] = h2; vault[35] = h3;
                vault[36] = h4; vault[37] = h5; vault[38] = h6; vault[39] = h7;
            } else if p1 == 4 {
                if p0 == 0 {
                    sk[0] = bswap32(h0); sk[1] = bswap32(h1); sk[2] = bswap32(h2); sk[3] = bswap32(h3);
                    sk[4] = bswap32(h4); sk[5] = bswap32(h5); sk[6] = bswap32(h6); sk[7] = bswap32(h7);
                } else {
                    u_in[0] = bswap32(h0); u_in[1] = bswap32(h1); u_in[2] = bswap32(h2); u_in[3] = bswap32(h3);
                    u_in[4] = bswap32(h4); u_in[5] = bswap32(h5); u_in[6] = bswap32(h6); u_in[7] = bswap32(h7);
                }
            } else if p1 == 6 {
                if p0 == 0 { acc[0] = bswap32(h0); acc[1] = bswap32(h1); acc[2] = bswap32(h2); }
                else { acc[3] = bswap32(h0); acc[4] = bswap32(h1); acc[5] = bswap32(h2); }
            } else {
                vault[40] = h0; vault[41] = h1; vault[42] = h2; vault[43] = h3;
                vault[44] = h4; vault[45] = h5; vault[46] = h6; vault[47] = h7;
            }
            p1 = p1 + 1;
        }
        p0 = p0 + 1;
    }

    // =========================================================================
    // STAGE 3: RFC 8439 ChaCha20-Poly1305 (p0=side: 0=Alice, 1=Bob; p1=auth_ok, p2=pt_match)
    // =========================================================================
    fe[48] = 1279544386; fe[49] = 1412253518; fe[50] = 858870604;  fe[51] = 1380276781;
    fe[52] = 1395475279; fe[53] = 1162037580; fe[54] = 1328362801; fe[55] = 2171211;
    fe[56] = 827542612;  fe[57] = 1094790451; fe[58] = 827731268;  fe[59] = 16777216;

    p1 = 0; p2 = 0; p0 = 0;
    while p0 < 2 {
        fe[0] = 1634760805; fe[1] = 857760878; fe[2] = 2036477234; fe[3] = 1797285236;
        i = 0;
        while i < 8 {
            if p0 == 0 { fe[4 + i] = sk[i]; } else { fe[4 + i] = u_in[i]; }
            i = i + 1;
        }
        if p0 == 0 { fe[13] = acc[0]; fe[14] = acc[1]; fe[15] = acc[2]; }
        else { fe[13] = acc[3]; fe[14] = acc[4]; fe[15] = acc[5]; }

        p3 = 0;
        while p3 < 2 {
            fe[12] = p3;
            i = 0; while i < 16 { fe[16 + i] = fe[i]; i = i + 1; }
            j = 0;
            while j < 10 {
                k = 0;
                while k < 8 {
                    q0 = 16 + (k & 3);
                    q1 = 20 + (((k & 3) + (k >> 2)) & 3);
                    q2 = 24 + (((k & 3) + (k >> 2) * 2) & 3);
                    q3 = 28 + (((k & 3) + (k >> 2) * 3) & 3);
                    a = fe[q0]; b = fe[q1]; c = fe[q2]; d = fe[q3];
                    a = (a + b) & m32; d = rotr32(d ^ a, 16);
                    c = (c + d) & m32; b = rotr32(b ^ c, 20);
                    a = (a + b) & m32; d = rotr32(d ^ a, 24);
                    c = (c + d) & m32; b = rotr32(b ^ c, 25);
                    fe[q0] = a; fe[q1] = b; fe[q2] = c; fe[q3] = d;
                    k = k + 1;
                }
                j = j + 1;
            }
            i = 0;
            while i < 8 {
                a = (fe[16 + i] + fe[i]) & m32;
                if p3 == 0 { fe[32 + i] = a; } else { fe[64 + i] = a; }
                i = i + 1;
            }
            p3 = p3 + 1;
        }

        if p0 == 0 {
            i = 0; while i < 8 { fe[40 + i] = (fe[48 + i] ^ fe[64 + i]) & m32; i = i + 1; }
        }

        // Poly1305: r0..r4 in fe[80..84], h0..h4 in h0..h4
        a = fe[32] & 268435455; b = fe[33] & 268435452; c = fe[34] & 268435452; d = fe[35] & 268435452;
        fe[80] = a & m26;
        fe[81] = ((a >> 26) | (b << 6)) & m26;
        fe[82] = ((b >> 20) | (c << 12)) & m26;
        fe[83] = ((c >> 14) | (d << 18)) & m26;
        fe[84] = (d >> 8) & m26;
        h0 = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0;
        p3 = 0;
        while p3 < 4 {
            q0 = 16; q1 = 0; q2 = 32; q3 = 0;
            if p3 == 0 { q0 = fe[56]; q1 = fe[57]; q2 = fe[58]; q3 = fe[59]; }
            else if p3 == 1 { q0 = fe[40]; q1 = fe[41]; q2 = fe[42]; q3 = fe[43]; }
            else if p3 == 2 { q0 = fe[44]; q1 = fe[45]; q2 = fe[46]; q3 = fe[47]; }
            h0 = h0 + (q0 & m26);
            h1 = h1 + (((q0 >> 26) | (q1 << 6)) & m26);
            h2 = h2 + (((q1 >> 20) | (q2 << 12)) & m26);
            h3 = h3 + (((q2 >> 14) | (q3 << 18)) & m26);
            h4 = h4 + ((q3 >> 8) | 16777216);
            a = h0 * fe[80] + h1 * (fe[84] * 5) + h2 * (fe[83] * 5) + h3 * (fe[82] * 5) + h4 * (fe[81] * 5);
            b = h0 * fe[81] + h1 * fe[80] + h2 * (fe[84] * 5) + h3 * (fe[83] * 5) + h4 * (fe[82] * 5);
            c = h0 * fe[82] + h1 * fe[81] + h2 * fe[80] + h3 * (fe[84] * 5) + h4 * (fe[83] * 5);
            d = h0 * fe[83] + h1 * fe[82] + h2 * fe[81] + h3 * fe[80] + h4 * (fe[84] * 5);
            e = h0 * fe[84] + h1 * fe[83] + h2 * fe[82] + h3 * fe[81] + h4 * fe[80];
            cp = a >> 26; h0 = a & m26; b = b + cp;
            cp = b >> 26; h1 = b & m26; c = c + cp;
            cp = c >> 26; h2 = c & m26; d = d + cp;
            cp = d >> 26; h3 = d & m26; e = e + cp;
            cp = e >> 26; h4 = e & m26; h0 = h0 + cp * 5;
            cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
            p3 = p3 + 1;
        }
        cp = h1 >> 26; h1 = h1 & m26; h2 = h2 + cp;
        cp = h2 >> 26; h2 = h2 & m26; h3 = h3 + cp;
        cp = h3 >> 26; h3 = h3 & m26; h4 = h4 + cp;
        cp = h4 >> 26; h4 = h4 & m26; h0 = h0 + cp * 5;
        cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
        a = h0 + 5; cp = a >> 26; a = a & m26;
        b = h1 + cp; cp = b >> 26; b = b & m26;
        c = h2 + cp; cp = c >> 26; c = c & m26;
        d = h3 + cp; cp = d >> 26; d = d & m26;
        if h4 + cp - 67108864 >= 0 { h0 = a; h1 = b; h2 = c; h3 = d; h4 = h4 + cp - 67108864; }
        a = ((h0 | (h1 << 26)) & m32) + fe[36]; cp = a >> 32; a = a & m32;
        b = (((h1 >> 6) | (h2 << 20)) & m32) + fe[37] + cp; cp = b >> 32; b = b & m32;
        c = (((h2 >> 12) | (h3 << 14)) & m32) + fe[38] + cp; cp = c >> 32; c = c & m32;
        d = ((((h3 >> 18) | (h4 << 8)) & m32) + fe[39] + cp) & m32;

        if p0 == 0 {
            acc[6] = a; acc[7] = b; acc[8] = c; acc[9] = d;
            if mode == 2 { fe[40] = fe[40] ^ 1; }
        } else {
            e = (a ^ acc[6]) | (b ^ acc[7]) | (c ^ acc[8]) | (d ^ acc[9]);
            if e == 0 {
                p1 = 1; p2 = 1; i = 0;
                while i < 8 {
                    if ((fe[40 + i] ^ fe[64 + i]) & m32) != fe[48 + i] { p2 = 0; }
                    i = i + 1;
                }
            }
        }
        p0 = p0 + 1;
    }

    a = 1;
    if p1 == 0 { if mode == 1 { a = -101; } else { a = -201; } }
    println("{}", a); println("{}", p1); println("{}", p2);
    i = 0; while i < 8 { println("{}", sk[i]); i = i + 1; }
    i = 0; while i < 3 { println("{}", acc[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", fe[40 + i]); i = i + 1; }
    i = 6; while i < 10 { println("{}", acc[i]); i = i + 1; }
    return a;
}

