// Wave 82D (Slice 14: F1/AC1/N53/N49): Pure-BuildLang Zero-C RFC 7748 X25519 Curve25519 ECDH
// (x25519_curve25519_zeroc.bld).
// Compiled with ZERO C compiler, ZERO Rust, ZERO linker via buildc_selfhost_crypto.bld
// across ALL FIVE targets (x64-pe, x64-elf, rv64-elf, aarch64-elf, wasm), each <= 16 KB.
// Constant-time Montgomery ladder over GF(2^255 - 19) in ten 25/26-bit limbs (zero u128).

fn x25519_suite(tamper_alice_sk: i64) -> i64 ~ Console {
    // 13 field-element slots x 10 limbs = 130 i64s (1,040 B stack; total frame < 1,750 B < 2,048 B)
    // Slots: 0=x1, 1=x2, 2=z2, 3=x3, 4=z3, 5=A, 6=B, 7=AA, 8=BB, 9=E, 10=C/inv, 11=D/base, 12=T1
    let mut fe: [i64; 130] = [0; 130];
    let mut acc: [i64; 10] = [0; 10];
    // Saved 8x32-bit LE outputs: [0..7]=Alice_pk, [8..15]=Bob_pk, [16..23]=Shared_AB
    let mut saved: [i64; 24] = [0; 24];
    let mut sk: [i64; 8] = [0; 8];
    let mut u_in: [i64; 8] = [0; 8];

    // Reused loop/scratch scalars to keep RV64/AArch64 frame strictly under 2,048 B
    let mut run_id: i64 = 0;
    let mut ecdh_match: i64 = 1;
    let mut low_order_rejected: i64 = 0;
    let mut i: i64 = 0;
    let mut j: i64 = 0;
    let mut k: i64 = 0;
    let mut cp: i64 = 0;

    while run_id < 5 {
        if run_id == 0 || run_id == 2 || run_id == 4 {
            sk[0] = 174917495;  sk[1] = 2107971699; sk[2] = 1925256764; sk[3] = 1164358225;
            sk[4] = 2268024031; sk[5] = 714719467;  sk[6] = 2784720817; sk[7] = 707574045;
            if tamper_alice_sk != 0 && run_id == 2 {
                sk[1] = sk[1] ^ 1;
            }
        } else {
            sk[0] = 2114497373; sk[1] = 1267354210; sk[2] = 2340413817; sk[3] = 3859710083;
            sk[4] = 699480943;  sk[5] = 4256569382; sk[6] = 663432988;  sk[7] = 3957360895;
        }
        sk[0] = sk[0] & 4294967288;
        sk[7] = (sk[7] & 2147483647) | 1073741824;

        i = 0;
        while i < 8 {
            if run_id == 2 { u_in[i] = saved[8 + i]; }
            else if run_id == 3 { u_in[i] = saved[i]; }
            else { u_in[i] = 0; }
            i = i + 1;
        }
        if run_id == 0 || run_id == 1 { u_in[0] = 9; }
        u_in[7] = u_in[7] & 2147483647;

        i = 0;
        while i < 130 { fe[i] = 0; i = i + 1; }

        let mut bit_pos: i64 = 0;
        i = 0;
        while i < 10 {
            let mut wb: i64 = 26;
            if (i & 1) != 0 { wb = 25; }
            let widx: i64 = bit_pos >> 5;
            let boff: i64 = bit_pos & 31;
            let mut v: i64 = u_in[widx] >> boff;
            if boff + wb > 32 && widx + 1 < 8 {
                v = v | (u_in[widx + 1] << (32 - boff));
            }
            v = v & ((1 << wb) - 1);
            fe[i] = v;
            fe[30 + i] = v;
            bit_pos = bit_pos + wb;
            i = i + 1;
        }
        fe[10] = 1;
        fe[40] = 1;

        // Phase 0: 255 constant-time Montgomery ladder steps + final cswap (step -1)
        // Phase 1: Fermat inversion z2^(2^255-21) + final x2*inv (step 255)
        let mut swap: i64 = 0;
        let mut phase: i64 = 0;
        let mut step: i64 = 254;
        while phase < 2 {
            let mut op: i64 = 0;
            let mut op_end: i64 = 18;
            if phase == 0 {
                let mut kt: i64 = 0;
                if step >= 0 { kt = (sk[step >> 5] >> (step & 31)) & 1; }
                swap = swap ^ kt;
                let cmask: i64 = 0 - swap;
                i = 0;
                while i < 10 {
                    let dx: i64 = cmask & (fe[10 + i] ^ fe[30 + i]);
                    fe[10 + i] = fe[10 + i] ^ dx;
                    fe[30 + i] = fe[30 + i] ^ dx;
                    let dz: i64 = cmask & (fe[20 + i] ^ fe[40 + i]);
                    fe[20 + i] = fe[20 + i] ^ dz;
                    fe[40 + i] = fe[40 + i] ^ dz;
                    i = i + 1;
                }
                swap = kt;
                if step < 0 { op_end = 0; }
            } else {
                op = 18;
                op_end = 20;
                if step == 255 { op = 20; op_end = 21; }
            }

            while op < op_end {
                // Packed micro-op: (kind<<12)|(dst<<8)|(sa<<4)|sb; kind: 1=add, 2=sub, 3=mul, 4=mul121665
                let mut ins: i64 = 0;
                if op == 0 { ins = 5394; }
                else if op == 1 { ins = 9746; }
                else if op == 2 { ins = 14165; }
                else if op == 3 { ins = 14438; }
                else if op == 4 { ins = 10616; }
                else if op == 5 { ins = 6708; }
                else if op == 6 { ins = 11060; }
                else if op == 7 { ins = 15541; }
                else if op == 8 { ins = 15014; }
                else if op == 9 { ins = 5066; }
                else if op == 10 { ins = 9418; }
                else if op == 11 { ins = 13107; }
                else if op == 12 { ins = 13380; }
                else if op == 13 { ins = 13316; }
                else if op == 14 { ins = 12664; }
                else if op == 15 { ins = 19600; } // kind=4, dst=12, sa=9 (T1 = E * 121665)
                else if op == 16 { ins = 7292; }
                else if op == 17 { ins = 12956; }
                else if op == 18 {
                    if step != 2 && step != 4 { ins = 15019; }
                } else if op == 19 { ins = 15291; }
                else { ins = 12570; }

                if ins != 0 {
                    let kind: i64 = ins >> 12;
                    let dd: i64 = ((ins >> 8) & 15) * 10;
                    let da: i64 = ((ins >> 4) & 15) * 10;
                    let db: i64 = (ins & 15) * 10;
                    if kind == 1 || kind == 2 || kind == 4 {
                        k = 0;
                        while k < 10 {
                            if kind == 1 { acc[k] = fe[da + k] + fe[db + k]; }
                            else if kind == 2 { acc[k] = fe[da + k] - fe[db + k]; }
                            else { acc[k] = fe[da + k] * 121665; }
                            k = k + 1;
                        }
                    } else {
                        k = 0;
                        while k < 10 { acc[k] = 0; k = k + 1; }
                        i = 0;
                        while i < 10 {
                            let ai: i64 = fe[da + i];
                            let i_odd: i64 = i & 1;
                            j = 0;
                            while j < 10 {
                                let mut idx: i64 = i + j;
                                let mut cff: i64 = 1;
                                if i_odd != 0 && (j & 1) != 0 { cff = 2; }
                                if idx >= 10 { idx = idx - 10; cff = cff * 19; }
                                acc[idx] = acc[idx] + ai * fe[db + j] * cff;
                                j = j + 1;
                            }
                            i = i + 1;
                        }
                    }
                    cp = 0;
                    while cp < 2 {
                        i = 0;
                        while i < 10 {
                            let mut sh: i64 = 26;
                            let mut mk: i64 = 67108863;
                            if (i & 1) != 0 { sh = 25; mk = 33554431; }
                            let cy: i64 = acc[i] >> sh;
                            acc[i] = acc[i] & mk;
                            if i < 9 { acc[i + 1] = acc[i + 1] + cy; }
                            else { acc[0] = acc[0] + cy * 19; }
                            i = i + 1;
                        }
                        cp = cp + 1;
                    }
                    i = 0;
                    while i < 10 { fe[dd + i] = acc[i]; i = i + 1; }
                }
                op = op + 1;
            }

            if phase == 0 {
                if step < 0 {
                    i = 0;
                    while i < 10 {
                        fe[100 + i] = 0;
                        fe[110 + i] = fe[20 + i];
                        i = i + 1;
                    }
                    fe[100] = 1;
                    phase = 1;
                    step = 0;
                } else {
                    step = step - 1;
                }
            } else {
                if step == 255 { phase = 2; }
                else { step = step + 1; }
            }
        }

        // Canonical reduction mod (2^255 - 19)
        i = 0;
        while i < 10 { acc[i] = fe[10 + i]; i = i + 1; }
        while acc[9] < 0 {
            acc[0] = acc[0] - 19;
            acc[9] = acc[9] + 33554432;
            cp = 0;
            while cp < 2 {
                i = 0;
                while i < 10 {
                    let mut sh: i64 = 26;
                    let mut mk: i64 = 67108863;
                    if (i & 1) != 0 { sh = 25; mk = 33554431; }
                    let cy: i64 = acc[i] >> sh;
                    acc[i] = acc[i] & mk;
                    if i < 9 { acc[i + 1] = acc[i + 1] + cy; }
                    else { acc[0] = acc[0] + cy * 19; }
                    i = i + 1;
                }
                cp = cp + 1;
            }
        }
        i = 0;
        while i < 10 { fe[120 + i] = acc[i]; i = i + 1; }
        fe[120] = fe[120] + 19;
        i = 0;
        while i < 9 {
            let mut sh: i64 = 26;
            let mut mk: i64 = 67108863;
            if (i & 1) != 0 { sh = 25; mk = 33554431; }
            let cy: i64 = fe[120 + i] >> sh;
            fe[120 + i] = fe[120 + i] & mk;
            fe[120 + i + 1] = fe[120 + i + 1] + cy;
            i = i + 1;
        }
        let top_c: i64 = fe[129] >> 25;
        fe[129] = fe[129] & 33554431;
        if top_c > 0 {
            i = 0;
            while i < 10 { acc[i] = fe[120 + i]; i = i + 1; }
        }

        // Pack 10 limbs into 8 x 32-bit LE words
        i = 0;
        while i < 8 { u_in[i] = 0; i = i + 1; }
        bit_pos = 0;
        i = 0;
        while i < 10 {
            let mut wb: i64 = 26;
            if (i & 1) != 0 { wb = 25; }
            let widx: i64 = bit_pos >> 5;
            let boff: i64 = bit_pos & 31;
            u_in[widx] = (u_in[widx] | ((acc[i] << boff) & 4294967295)) & 4294967295;
            if boff + wb > 32 && widx + 1 < 8 {
                u_in[widx + 1] = (u_in[widx + 1] | (acc[i] >> (32 - boff))) & 4294967295;
            }
            bit_pos = bit_pos + wb;
            i = i + 1;
        }

        let mut nz_or: i64 = 0;
        i = 0;
        while i < 8 {
            nz_or = nz_or | u_in[i];
            if run_id < 3 {
                saved[run_id * 8 + i] = u_in[i];
                println("{}", u_in[i]);
            } else if run_id == 3 {
                if u_in[i] != saved[16 + i] { ecdh_match = 0; }
            }
            i = i + 1;
        }
        if run_id == 4 && nz_or == 0 { low_order_rejected = 1; }
        run_id = run_id + 1;
    }

    println("{}", ecdh_match);
    println("{}", low_order_rejected);
    return ecdh_match;
}

fn main() ~ Console {
    let _ = x25519_suite(0);
}
