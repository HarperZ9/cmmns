// Wave 91B (Author Idea N28, SIG-095): Zero-Heap WASM Universal Three-Control
// Negatives Validator (false-pass trap, false-fail golden ref, 200-permutation
// shuffled-null Pearson correlation p-value <= alpha). Zero heap, zero math imports.

fn i2f(n: i32) -> f64 {
    let mut f: f64 = 0.0;
    let mut i: i32 = 0;
    while i < n {
        f = f + 1.0;
        i = i + 1;
    }
    f
}

fn w_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0; }
    let mut g: f64 = if x > 1.0 { x } else { 1.0 };
    let mut i: i32 = 0;
    while i < 24 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

// Deterministic pseudo-random unit noise in [-0.5, 0.5] from index and seed
fn unit_noise(idx: i32, seed: i32) -> f64 {
    let mut x: i32 = (idx * 374761393 + seed * 668265263) ^ 1274126177;
    x = (x ^ (x >> 13)) * 1274126177;
    x = x ^ (x >> 16);
    let u: i32 = x & 65535;
    (i2f(u) / 65536.0) - 0.5
}

fn sample_y(is_signal: i32, idx: i32) -> f64 {
    let xi: f64 = i2f(idx) * 0.1;
    if is_signal != 0 {
        return 2.0 * xi + 0.35 * unit_noise(idx, 17);
    }
    unit_noise(idx, 91)
}

// Bijective permutation of 0..47 using stride coprime to 48
fn perm_index(idx: i32, perm_id: i32) -> i32 {
    if perm_id < 0 {
        return idx;
    }
    let s_idx: i32 = perm_id % 16;
    let stride: i32 = if s_idx == 0 { 1 }
        else if s_idx == 1 { 5 } else if s_idx == 2 { 7 } else if s_idx == 3 { 11 }
        else if s_idx == 4 { 13 } else if s_idx == 5 { 17 } else if s_idx == 6 { 19 }
        else if s_idx == 7 { 23 } else if s_idx == 8 { 25 } else if s_idx == 9 { 29 }
        else if s_idx == 10 { 31 } else if s_idx == 11 { 35 } else if s_idx == 12 { 37 }
        else if s_idx == 13 { 41 } else if s_idx == 14 { 43 } else { 47 };
    let off: i32 = (perm_id * 11 + 7) % 48;
    (idx * stride + off) % 48
}

// Compute Pearson correlation r over n=48 pairs (perm_id < 0 => unpermuted observed)
pub fn pearson_r(is_signal: i32, perm_id: i32) -> f64 {
    let n: i32 = 48;
    let nf: f64 = 48.0;
    let mut sum_x: f64 = 0.0;
    let mut sum_y: f64 = 0.0;
    let mut i: i32 = 0;
    while i < n {
        sum_x = sum_x + i2f(i) * 0.1;
        sum_y = sum_y + sample_y(is_signal, perm_index(i, perm_id));
        i = i + 1;
    }
    let mx: f64 = sum_x / nf;
    let my: f64 = sum_y / nf;

    let mut num: f64 = 0.0;
    let mut dx2: f64 = 0.0;
    let mut dy2: f64 = 0.0;
    i = 0;
    while i < n {
        let dx: f64 = i2f(i) * 0.1 - mx;
        let dy: f64 = sample_y(is_signal, perm_index(i, perm_id)) - my;
        num = num + dx * dy;
        dx2 = dx2 + dx * dx;
        dy2 = dy2 + dy * dy;
        i = i + 1;
    }
    if dx2 <= 1.0e-18 || dy2 <= 1.0e-18 {
        return 0.0;
    }
    num / w_sqrt(dx2 * dy2)
}

// Exact 200-permutation shuffled-null p-value: (1 + count(r_perm >= r_obs)) / 201
pub fn perm_p_value(is_signal: i32) -> f64 {
    let r_obs: f64 = pearson_r(is_signal, -1);
    let mut ge_count: i32 = 0;
    let mut p: i32 = 0;
    while p < 200 {
        let r_p: f64 = pearson_r(is_signal, p);
        if r_p >= r_obs {
            ge_count = ge_count + 1;
        }
        p = p + 1;
    }
    i2f(1 + ge_count) / 201.0
}

// Fail-closed three-control validator:
// 0=PASS, -201=NO_FALSE_PASS_TRAP, -202=NO_FALSE_FAIL_REF, -203=NULL_P_TOO_HIGH
pub fn validate_three_controls(
    fp_exists: i32,
    fp_rejected: i32,
    ff_exists: i32,
    ff_passed: i32,
    p_perm: f64,
    alpha: f64,
) -> i32 {
    if fp_exists == 0 || fp_rejected == 0 {
        return -201;
    }
    if ff_exists == 0 || ff_passed == 0 {
        return -202;
    }
    if p_perm > alpha || p_perm < 0.0 || p_perm != p_perm {
        return -203;
    }
    0
}

fn main() -> i32 {
    0
}
