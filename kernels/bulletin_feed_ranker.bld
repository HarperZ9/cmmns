//
// Wave 58D Kernel 2 (Author Idea E20, Formula SIG-118):
//   Bulletin Shared Human+Model Work Feed Deduplicator and Verification-Weighted Ranker.
//   Ranks entries by (verified_receipt_weight * novelty_distance) / (1 + 0.15 * age_hours),
//   deduplicates exact and near-identical digests (Hamming <= 2), and rejects unverified
//   hype spam and duplicate floods fail-closed.

fn popcount32(x: u64) -> u64 {
    let mut v: u64 = x & 4294967295;
    let mut c: u64 = 0;
    while v > 0 {
        c = c + (v & 1);
        v = v >> 1;
    }
    c
}

fn is_near_dup(h: u64, accepted: &Vec<u64>) -> i32 {
    let mut i: usize = 0;
    while i < accepted.len() {
        let dist: u64 = popcount32(h ^ accepted[i]);
        if dist <= 2 {
            return 1;
        }
        i = i + 1;
    }
    0
}

fn score_entry(verified: i32, weight: f64, novelty: f64, age_hours: f64) -> f64 {
    if verified == 0 || weight <= 0.0 || novelty <= 0.0 || age_hours < 0.0 {
        return 0.0;
    }
    let age_decay: f64 = 1.0 + (0.15 * age_hours);
    (weight * novelty) / age_decay
}

struct FeedResult {
    accepted_count: usize,
    dup_dropped: usize,
    unverified_dropped: usize,
    top1_id: u64,
    top2_id: u64,
    top3_id: u64,
    top4_id: u64,
    top1_score: f64,
    score_sum: f64,
}

fn rank_feed(
    ids: &Vec<u64>,
    hashes: &Vec<u64>,
    verified: &Vec<i32>,
    weights: &Vec<f64>,
    novelties: &Vec<f64>,
    ages: &Vec<f64>,
) -> FeedResult {
    let mut acc_ids: Vec<u64> = Vec::new();
    let mut acc_hashes: Vec<u64> = Vec::new();
    let mut acc_scores: Vec<f64> = Vec::new();
    let mut dup_cnt: usize = 0;
    let mut unv_cnt: usize = 0;

    let mut i: usize = 0;
    while i < ids.len() {
        if verified[i] == 0 || weights[i] <= 0.0 {
            unv_cnt = unv_cnt + 1;
        } else if is_near_dup(hashes[i], &acc_hashes) == 1 {
            dup_cnt = dup_cnt + 1;
        } else {
            let sc: f64 = score_entry(verified[i], weights[i], novelties[i], ages[i]);
            acc_ids.push(ids[i]);
            acc_hashes.push(hashes[i]);
            acc_scores.push(sc);
        }
        i = i + 1;
    }

    // Insertion sort descending by score (deterministic tie-break on lower id)
    let n: usize = acc_ids.len();
    let mut a: usize = 1;
    while a < n {
        let key_s: f64 = acc_scores[a];
        let key_id: u64 = acc_ids[a];
        let mut b: usize = a;
        while b > 0 && acc_scores[b - 1] < key_s {
            acc_scores[b] = acc_scores[b - 1];
            acc_ids[b] = acc_ids[b - 1];
            b = b - 1;
        }
        acc_scores[b] = key_s;
        acc_ids[b] = key_id;
        a = a + 1;
    }

    let mut s_sum: f64 = 0.0;
    let mut k: usize = 0;
    while k < n {
        s_sum = s_sum + acc_scores[k];
        k = k + 1;
    }

    let t1: u64 = if n > 0 { acc_ids[0] } else { 0 };
    let t2: u64 = if n > 1 { acc_ids[1] } else { 0 };
    let t3: u64 = if n > 2 { acc_ids[2] } else { 0 };
    let t4: u64 = if n > 3 { acc_ids[3] } else { 0 };
    let ts1: f64 = if n > 0 { acc_scores[0] } else { 0.0 };

    FeedResult {
        accepted_count: n,
        dup_dropped: dup_cnt,
        unverified_dropped: unv_cnt,
        top1_id: t1,
        top2_id: t2,
        top3_id: t3,
        top4_id: t4,
        top1_score: ts1,
        score_sum: s_sum,
    }
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;

    // 10 candidate posts: 5 verified unique, 3 planted near-duplicates, 2 planted unverified hype
    let mut ids: Vec<u64> = Vec::new();
    let mut hashes: Vec<u64> = Vec::new();
    let mut ver: Vec<i32> = Vec::new();
    let mut wts: Vec<f64> = Vec::new();
    let mut nov: Vec<f64> = Vec::new();
    let mut ages: Vec<f64> = Vec::new();

    // Clean verified posts (distant hashes)
    ids.push(101); hashes.push(2863311530); ver.push(1); wts.push(1.8); nov.push(0.85); ages.push(2.0);
    ids.push(102); hashes.push(858993459);  ver.push(1); wts.push(2.4); nov.push(0.92); ages.push(1.0);
    ids.push(103); hashes.push(4042322160); ver.push(1); wts.push(1.5); nov.push(0.70); ages.push(6.0);
    ids.push(104); hashes.push(252645135);  ver.push(1); wts.push(2.0); nov.push(0.95); ages.push(3.0);
    ids.push(105); hashes.push(3435973836); ver.push(1); wts.push(1.2); nov.push(0.60); ages.push(0.5);

    // Planted control 1: Duplicate flood (exact + 1-bit + 2-bit Hamming of post 102)
    ids.push(201); hashes.push(858993459);     ver.push(1); wts.push(2.4); nov.push(0.92); ages.push(0.1);
    ids.push(202); hashes.push(858993459 ^ 1); ver.push(1); wts.push(2.4); nov.push(0.92); ages.push(0.1);
    ids.push(203); hashes.push(858993459 ^ 5); ver.push(1); wts.push(2.4); nov.push(0.92); ages.push(0.1);

    // Planted control 2: Unverified hype spam (massive novelty, tiny age, verified=0)
    ids.push(301); hashes.push(16711935);   ver.push(0); wts.push(5.0); nov.push(99.0); ages.push(0.01);
    ids.push(302); hashes.push(4278255360); ver.push(0); wts.push(9.0); nov.push(50.0); ages.push(0.05);

    let res: FeedResult = rank_feed(&ids, &hashes, &ver, &wts, &nov, &ages);

    if res.accepted_count == 5 && res.top1_id == 102 && res.top2_id == 104
        && res.top3_id == 101 && res.top4_id == 105
    {
        println!(
            "[PASS] e20_verified_ranking order={},{},{},{} top1_score={:.6}",
            res.top1_id, res.top2_id, res.top3_id, res.top4_id, res.top1_score
        );
    } else {
        println!(
            "[FAIL] e20_verified_ranking acc={} order={},{},{},{}",
            res.accepted_count, res.top1_id, res.top2_id, res.top3_id, res.top4_id
        );
        failures = failures + 1;
    }

    if res.dup_dropped == 3 {
        println!("[PASS] e20_planted_duplicate_flood dropped=3/3");
    } else {
        println!("[FAIL] e20_planted_duplicate_flood dropped={}", res.dup_dropped);
        failures = failures + 1;
    }

    if res.unverified_dropped == 2 && score_entry(0, 5.0, 99.0, 0.01) == 0.0 {
        println!("[PASS] e20_planted_unverified_hype rejected=2/2");
    } else {
        println!("[FAIL] e20_planted_unverified_hype rejected={}", res.unverified_dropped);
        failures = failures + 1;
    }

    // Throughput benchmark: 10,000 full feed dedup + ranking passes
    let n_iters: usize = 10000;
    let t0: i64 = clock_ns();
    let mut sum_acc: f64 = 0.0;
    let mut it: usize = 0;
    while it < n_iters {
        let r: FeedResult = rank_feed(&ids, &hashes, &ver, &wts, &nov, &ages);
        sum_acc = sum_acc + r.top1_score;
        it = it + 1;
    }
    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1000000.0;
    let passes_per_s: f64 = if elapsed_ms > 0.0 {
        ((n_iters as f64) * 1000.0) / elapsed_ms
    } else {
        0.0
    };

    println!(
        "[METRICS] e20 acc={} dup={} unv={} top1={} top2={} top3={} top4={}",
        res.accepted_count, res.dup_dropped, res.unverified_dropped,
        res.top1_id, res.top2_id, res.top3_id, res.top4_id
    );
    println!(
        "[METRICS] e20 top1_score={:.6} score_sum={:.6} passes_per_s={:.2} elapsed_ms={:.4}",
        res.top1_score, res.score_sum, passes_per_s, elapsed_ms
    );

    if failures == 0 && sum_acc > 0.0 {
        println!("[OK] bulletin_feed_ranker ALL CHECKS PASSED (failures=0)");
    } else {
        println!("[ERR] bulletin_feed_ranker failures={}", failures);
    }
}
