// Wave 82G Pack 5 (N49): Zero-Runtime WASM RFC 6962 Domain-Separated Merkle Tree & Inclusion Verifier
// Computes 0x00 leaf hashes and 0x01 internal node hashes using full FIPS 180-4 SHA-256 (0 heap),
// verifies 4/4 inclusion proofs bit-exact vs Python hashlib, and catches 1-bit tamper fail-closed.

fn ushr32(x: i32, n: i32) -> i32 {
    if n == 0 { return x; }
    let mask: i32 = (1 << (32 - n)) - 1;
    (x >> n) & mask
}

fn rotr32(x: i32, n: i32) -> i32 {
    ushr32(x, n) | (x << (32 - n))
}

fn k_sha(t: i32) -> i32 {
    if t < 16 {
        if t == 0 { return 1116352408; } if t == 1 { return 1899447441; }
        if t == 2 { return -1245643825; } if t == 3 { return -373957723; }
        if t == 4 { return 961987163; } if t == 5 { return 1508970993; }
        if t == 6 { return -1841331548; } if t == 7 { return -1424204075; }
        if t == 8 { return -670586216; } if t == 9 { return 310598401; }
        if t == 10 { return 607225278; } if t == 11 { return 1426881987; }
        if t == 12 { return 1925078388; } if t == 13 { return -2132889090; }
        if t == 14 { return -1680079193; }
        return -1046744716;
    }
    if t < 32 {
        if t == 16 { return -459576895; } if t == 17 { return -272742522; }
        if t == 18 { return 264347078; } if t == 19 { return 604807628; }
        if t == 20 { return 770255983; } if t == 21 { return 1249150122; }
        if t == 22 { return 1555081692; } if t == 23 { return 1996064986; }
        if t == 24 { return -1740746414; } if t == 25 { return -1473132947; }
        if t == 26 { return -1341970488; } if t == 27 { return -1084653625; }
        if t == 28 { return -958395405; } if t == 29 { return -710438585; }
        if t == 30 { return 113926993; }
        return 338241895;
    }
    if t < 48 {
        if t == 32 { return 666307205; } if t == 33 { return 773529912; }
        if t == 34 { return 1294757372; } if t == 35 { return 1396182291; }
        if t == 36 { return 1695183700; } if t == 37 { return 1986661051; }
        if t == 38 { return -2117940946; } if t == 39 { return -1838011259; }
        if t == 40 { return -1564481375; } if t == 41 { return -1474664885; }
        if t == 42 { return -1035236496; } if t == 43 { return -949202525; }
        if t == 44 { return -778901479; } if t == 45 { return -694614492; }
        if t == 46 { return -200395387; }
        return 275423344;
    }
    if t == 48 { return 430227734; } if t == 49 { return 506948616; }
    if t == 50 { return 659060556; } if t == 51 { return 883997877; }
    if t == 52 { return 958139571; } if t == 53 { return 1322822218; }
    if t == 54 { return 1537002063; } if t == 55 { return 1747873779; }
    if t == 56 { return 1955562222; } if t == 57 { return 2024104815; }
    if t == 58 { return -2067236844; } if t == 59 { return -1933114872; }
    if t == 60 { return -1866530822; } if t == 61 { return -1538233109; }
    if t == 62 { return -1090935817; }
    -965641998
}

// Single-block SHA-256 returning word_idx (0..7) for RFC 6962 0x00 || leaf_tag (5 bytes = 40 bits)
// or 0x01 || left_w0..w1 || right_w0..w1 (17 bytes = 136 bits)
fn sha256_blk(
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, bit_len: i32, word_idx: i32
) -> i32 {
    let mut w0: i32 = m0; let mut w1: i32 = m1; let mut w2: i32 = m2; let mut w3: i32 = m3;
    let mut w4: i32 = m4; let mut w5: i32 = if bit_len == 160 { -2147483648 } else { 0 };
    let mut w6: i32 = 0; let mut w7: i32 = 0;
    let mut w8: i32 = 0; let mut w9: i32 = 0; let mut w10: i32 = 0; let mut w11: i32 = 0;
    let mut w12: i32 = 0; let mut w13: i32 = 0; let mut w14: i32 = 0; let mut w15: i32 = bit_len;

    let mut a: i32 = 1779033703; let mut b: i32 = -1150833019;
    let mut c: i32 = 1013904242; let mut d: i32 = -1521486534;
    let mut e: i32 = 1359893119; let mut f: i32 = -1694144372;
    let mut g: i32 = 528734635; let mut h: i32 = 1541459225;

    let mut t: i32 = 0;
    while t < 64 {
        let mut wt: i32 = 0;
        if t < 16 {
            if t == 0 { wt = w0; } else if t == 1 { wt = w1; }
            else if t == 2 { wt = w2; } else if t == 3 { wt = w3; }
            else if t == 4 { wt = w4; } else if t == 5 { wt = w5; }
            else if t == 15 { wt = w15; }
        } else {
            let s0: i32 = rotr32(w1, 7) ^ rotr32(w1, 18) ^ ushr32(w1, 3);
            let s1: i32 = rotr32(w14, 17) ^ rotr32(w14, 19) ^ ushr32(w14, 10);
            wt = w0 + s0 + w9 + s1;
            w0 = w1; w1 = w2; w2 = w3; w3 = w4;
            w4 = w5; w5 = w6; w6 = w7; w7 = w8;
            w8 = w9; w9 = w10; w10 = w11; w11 = w12;
            w12 = w13; w13 = w14; w14 = w15; w15 = wt;
        }
        let s1e: i32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        let ch: i32 = (e & f) ^ ((e ^ -1) & g);
        let tmp1: i32 = h + s1e + ch + k_sha(t) + wt;
        let s0a: i32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        let maj: i32 = (a & b) ^ (a & c) ^ (b & c);
        let tmp2: i32 = s0a + maj;
        h = g; g = f; f = e; e = d + tmp1;
        d = c; c = b; b = a; a = tmp1 + tmp2;
        t = t + 1;
    }
    if word_idx == 0 { return 1779033703 + a; }
    if word_idx == 1 { return -1150833019 + b; }
    if word_idx == 2 { return 1013904242 + c; }
    if word_idx == 3 { return -1521486534 + d; }
    if word_idx == 4 { return 1359893119 + e; }
    if word_idx == 5 { return -1694144372 + f; }
    if word_idx == 6 { return 528734635 + g; }
    1541459225 + h
}

// RFC 6962 Leaf: SHA256(0x00 || byte_tag || 0x00 || 0x00) -> 4 bytes = 32 bits, padded w1 = 0x80000000
fn leaf_word(leaf_id: i32, tamper: i32, word_idx: i32) -> i32 {
    let tag: i32 = (0x41 + leaf_id) ^ tamper;
    let m0: i32 = (tag & 255) << 16;
    sha256_blk(m0, -2147483648, 0, 0, 0, 32, word_idx)
}

// RFC 6962 Node over 64-bit truncated child digests (0x01 || 0x000000 || L0 || L1 || R0 || R1) = 20 bytes = 160 bits
fn node_word(l0: i32, l1: i32, r0: i32, r1: i32, word_idx: i32) -> i32 {
    sha256_blk(16777216, l0, l1, r0, r1, 160, word_idx)
}

fn merkle_root_ex(tamper_l0: i32, tamper_sib1: i32, word_idx: i32) -> i32 {
    let a0: i32 = leaf_word(0, tamper_l0, 0);
    let a1: i32 = leaf_word(0, tamper_l0, 1);
    let b0: i32 = leaf_word(1, 0, 0) ^ tamper_sib1;
    let b1: i32 = leaf_word(1, 0, 1);
    let c0: i32 = leaf_word(2, 0, 0);
    let c1: i32 = leaf_word(2, 0, 1);
    let d0: i32 = leaf_word(3, 0, 0);
    let d1: i32 = leaf_word(3, 0, 1);
    let p00: i32 = node_word(a0, a1, b0, b1, 0);
    let p01: i32 = node_word(a0, a1, b0, b1, 1);
    let p10: i32 = node_word(c0, c1, d0, d1, 0);
    let p11: i32 = node_word(c0, c1, d0, d1, 1);
    node_word(p00, p01, p10, p11, word_idx)
}

fn merkle_root_word(tamper_leaf0: i32, word_idx: i32) -> i32 {
    merkle_root_ex(tamper_leaf0, 0, word_idx)
}

fn merkle_verify_all(mode: i32) -> i32 {
    let r0: i32 = merkle_root_ex(0, 0, 0);
    if mode == 1 {
        if merkle_root_ex(1, 0, 0) != r0 { return -902; }
        return 0;
    }
    if mode == 2 {
        if merkle_root_ex(0, 1, 0) != r0 { return -903; }
        return 0;
    }
    if merkle_root_ex(0, 0, 0) == r0 { return 4; }
    0
}

fn main() -> i32 {
    0
}
