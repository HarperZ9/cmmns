//
// Wave 58D Kernel 3 (Author Idea I2, Formula SIG-119):
//   Knowledge-as-Pipe Open-Commons Mirror Integrity and Zero-Gate Flow Auditor.
//   Verifies bit-exact FIPS 180-4 SHA-256 parity across 4 distributed mirror nodes,
//   zero paywall or auth-gate header leakage, and >= 3/4 Byzantine mirror quorum,
//   rejecting corrupted mirrors and paywall-injected nodes fail-closed.

fn rotr32(x: u64, n: u64) -> u64 {
    let m: u64 = 4294967295;
    let v: u64 = x & m;
    ((v >> n) | ((v << (32 - n)) & m)) & m
}

fn sha256_k() -> Vec<u64> {
    let mut k: Vec<u64> = Vec::new();
    k.push(1116352408); k.push(1899447441); k.push(3049323471); k.push(3921009573);
    k.push(961987163);  k.push(1508970993); k.push(2453635748); k.push(2870763221);
    k.push(3624381080); k.push(310598401);  k.push(607225278);  k.push(1426881987);
    k.push(1925078388); k.push(2162078206); k.push(2614888103); k.push(3248222580);
    k.push(3835390401); k.push(4022224774); k.push(264347078);  k.push(604807628);
    k.push(770255983);  k.push(1249150122); k.push(1555081692); k.push(1996064986);
    k.push(2554220882); k.push(2821834349); k.push(2952996808); k.push(3210313671);
    k.push(3336571891); k.push(3584528711); k.push(113926993);  k.push(338241895);
    k.push(666307205);  k.push(773529912);  k.push(1294757372); k.push(1396182291);
    k.push(1695183700); k.push(1986661051); k.push(2177026350); k.push(2456956037);
    k.push(2730485921); k.push(2820302411); k.push(3259730800); k.push(3345764771);
    k.push(3516065817); k.push(3600352804); k.push(4094571909); k.push(275423344);
    k.push(430227734);  k.push(506948616);  k.push(659060556);  k.push(883997877);
    k.push(958139571);  k.push(1322822218); k.push(1537002063); k.push(1747873779);
    k.push(1955562222); k.push(2024104815); k.push(2227730452); k.push(2361852424);
    k.push(2428436474); k.push(2756734187); k.push(3204031479); k.push(3329325298);
    k
}

fn sha256_bytes(msg: &Vec<u64>, k_tbl: &Vec<u64>) -> Vec<u64> {
    let m32: u64 = 4294967295;
    let mut padded: Vec<u64> = Vec::new();
    let n: usize = msg.len();
    let mut i: usize = 0;
    while i < n {
        padded.push(msg[i] & 255);
        i = i + 1;
    }
    padded.push(128);
    while (padded.len() % 64) != 56 {
        padded.push(0);
    }
    let bit_len: u64 = (n as u64) * 8;
    let mut sh: i32 = 56;
    while sh >= 0 {
        padded.push((bit_len >> (sh as u64)) & 255);
        sh = sh - 8;
    }

    let mut h0: u64 = 1779033703; let mut h1: u64 = 3144134277;
    let mut h2: u64 = 1013904242; let mut h3: u64 = 2773480762;
    let mut h4: u64 = 1359893119; let mut h5: u64 = 2600822924;
    let mut h6: u64 = 528734635;  let mut h7: u64 = 1541459225;

    let mut w: Vec<u64> = Vec::new();
    let mut wi: usize = 0;
    while wi < 64 {
        w.push(0);
        wi = wi + 1;
    }

    let mut blk: usize = 0;
    while blk < padded.len() {
        let mut j: usize = 0;
        while j < 16 {
            let o: usize = blk + j * 4;
            w[j] = (padded[o] << 24) | (padded[o + 1] << 16)
                | (padded[o + 2] << 8) | padded[o + 3];
            j = j + 1;
        }
        j = 16;
        while j < 64 {
            let s0: u64 = rotr32(w[j - 15], 7) ^ rotr32(w[j - 15], 18) ^ (w[j - 15] >> 3);
            let s1: u64 = rotr32(w[j - 2], 17) ^ rotr32(w[j - 2], 19) ^ (w[j - 2] >> 10);
            w[j] = (w[j - 16] + s0 + w[j - 7] + s1) & m32;
            j = j + 1;
        }

        let mut a: u64 = h0; let mut b: u64 = h1; let mut c: u64 = h2; let mut d: u64 = h3;
        let mut e: u64 = h4; let mut f: u64 = h5; let mut g: u64 = h6; let mut hh: u64 = h7;

        j = 0;
        while j < 64 {
            let s1: u64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: u64 = (e & f) ^ (((e ^ m32) & m32) & g);
            let t1: u64 = (hh + s1 + ch + k_tbl[j] + w[j]) & m32;
            let s0: u64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: u64 = (a & b) ^ (a & c) ^ (b & c);
            let t2: u64 = (s0 + maj) & m32;
            hh = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32;
            j = j + 1;
        }
        h0 = (h0 + a) & m32; h1 = (h1 + b) & m32; h2 = (h2 + c) & m32; h3 = (h3 + d) & m32;
        h4 = (h4 + e) & m32; h5 = (h5 + f) & m32; h6 = (h6 + g) & m32; h7 = (h7 + hh) & m32;
        blk = blk + 64;
    }

    let mut out: Vec<u64> = Vec::new();
    let mut ws: Vec<u64> = Vec::new();
    ws.push(h0); ws.push(h1); ws.push(h2); ws.push(h3);
    ws.push(h4); ws.push(h5); ws.push(h6); ws.push(h7);
    let mut idx: usize = 0;
    while idx < 8 {
        out.push((ws[idx] >> 24) & 255);
        out.push((ws[idx] >> 16) & 255);
        out.push((ws[idx] >> 8) & 255);
        out.push(ws[idx] & 255);
        idx = idx + 1;
    }
    out
}

fn ct_eq32(a: &Vec<u64>, b: &Vec<u64>) -> i32 {
    if a.len() != 32 || b.len() != 32 {
        return 0;
    }
    let mut diff: u64 = 0;
    let mut i: usize = 0;
    while i < 32 {
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    }
    if diff == 0 { 1 } else { 0 }
}

fn word_at(d: &Vec<u64>, o: usize) -> u64 {
    (d[o] << 24) | (d[o + 1] << 16) | (d[o + 2] << 8) | d[o + 3]
}

fn make_commons_chunk() -> Vec<u64> {
    let mut chunk: Vec<u64> = Vec::new();
    let mut i: u64 = 0;
    while i < 128 {
        chunk.push((i * 41 + 73) & 255);
        i = i + 1;
    }
    chunk
}

fn has_gate_header(headers: &String) -> i32 {
    let low: String = headers.to_lowercase();
    if low.contains("x-paywall")
        || low.contains("402 payment")
        || low.contains("authorization:")
        || low.contains("subscribe-wall")
        || low.contains("login-required")
    {
        1
    } else {
        0
    }
}

fn audit_node(
    payload: &Vec<u64>,
    headers: &String,
    expected_sha: &Vec<u64>,
    k_tbl: &Vec<u64>,
) -> i32 {
    if has_gate_header(headers) == 1 {
        return 0;
    }
    let dig: Vec<u64> = sha256_bytes(payload, k_tbl);
    ct_eq32(&dig, expected_sha)
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;
    let k_tbl: Vec<u64> = sha256_k();

    let canonical: Vec<u64> = make_commons_chunk();
    let expected_sha: Vec<u64> = sha256_bytes(&canonical, &k_tbl);

    let clean_hdr: String = "HTTP/1.1 200 OK; Content-Type: application/json; Access-Control-Allow-Origin: *";
    let paywall_hdr: String = "HTTP/1.1 402 Payment Required; X-Paywall: tier-pro; Subscribe-Wall: hard";
    let auth_hdr: String = "HTTP/1.1 401; Authorization: Bearer required; Login-Required: true";

    // 1. Healthy 4/4 mirror quorum
    let m0: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    let m1: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    let m2: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    let m3: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    let q_clean: i32 = m0 + m1 + m2 + m3;
    if q_clean == 4 {
        println!("[PASS] i2_clean_mirror_quorum honest=4/4");
    } else {
        println!("[FAIL] i2_clean_mirror_quorum honest={}/4", q_clean);
        failures = failures + 1;
    }

    // 2. Single Byzantine faulty mirror (1-bit chunk flip on M2) -> 3/4 quorum still holds
    let mut bad_chunk: Vec<u64> = make_commons_chunk();
    bad_chunk[63] = bad_chunk[63] ^ 1;
    let q_bft: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&bad_chunk, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    if q_bft == 3 {
        println!("[PASS] i2_bft_single_fault_tolerated honest=3/4 quarantined=1");
    } else {
        println!("[FAIL] i2_bft_single_fault_tolerated honest={}/4", q_bft);
        failures = failures + 1;
    }

    // 3. Planted control 1: Double mirror corruption breaks 3/4 quorum -> fail-closed
    let mut bad_chunk2: Vec<u64> = make_commons_chunk();
    bad_chunk2[12] = bad_chunk2[12] ^ 1;
    let q_corrupt: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&bad_chunk, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&bad_chunk2, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
    if q_corrupt < 3 {
        println!("[PASS] i2_planted_double_corrupt rejected=1 honest={}/4", q_corrupt);
    } else {
        println!("[FAIL] i2_planted_double_corrupt honest={}/4", q_corrupt);
        failures = failures + 1;
    }

    // 4. Planted control 2: Paywall/auth-gate header injection -> fail-closed
    let q_paywall: i32 = audit_node(&canonical, &paywall_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
        + audit_node(&canonical, &auth_hdr, &expected_sha, &k_tbl);
    if q_paywall < 3 {
        println!("[PASS] i2_planted_paywall_injection rejected=1 honest={}/4", q_paywall);
    } else {
        println!("[FAIL] i2_planted_paywall_injection honest={}/4", q_paywall);
        failures = failures + 1;
    }

    // Throughput benchmark: 500 full 4-mirror SHA-256 + header quorum audits
    let n_runs: usize = 500;
    let t0: i64 = clock_ns();
    let mut pass_audits: i64 = 0;
    let mut r: usize = 0;
    while r < n_runs {
        let q: i32 = audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
            + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
            + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl)
            + audit_node(&canonical, &clean_hdr, &expected_sha, &k_tbl);
        if q >= 3 {
            pass_audits = pass_audits + 1;
        }
        r = r + 1;
    }
    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1000000.0;
    let audits_per_s: f64 = if elapsed_ms > 0.0 {
        ((n_runs as f64) * 1000.0) / elapsed_ms
    } else {
        0.0
    };

    let chunk_w0: u64 = word_at(&expected_sha, 0);
    let chunk_w7: u64 = word_at(&expected_sha, 28);
    println!(
        "[METRICS] i2 chunk_w0={} chunk_w7={} q_clean={} q_bft={} q_corrupt={} q_paywall={}",
        chunk_w0, chunk_w7, q_clean, q_bft, q_corrupt, q_paywall
    );
    println!(
        "[METRICS] i2 pass_audits={} audits_per_s={:.2} elapsed_ms={:.4}",
        pass_audits, audits_per_s, elapsed_ms
    );

    if failures == 0 && pass_audits == 500 {
        println!("[OK] commons_pipe_mirror ALL CHECKS PASSED (failures=0)");
    } else {
        println!("[ERR] commons_pipe_mirror failures={}", failures);
    }
}
