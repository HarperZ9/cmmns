// Wave 156A Pack 17 (Superframe Renderer Module #34: art_palettelight -> WASM):
//   Palette-Locked Lighting with Two-Phase Bayer 8x8 Dithering & OKLab Cool/Warm Ramps.
//   Bit-exact 0-ULP FNV-1a parity against C++23 native/src/renderer/style_palettelight.cpp.

fn pi_c() -> f64 { 3.14159265358979323846 }
fn min_d(a: f64, b: f64) -> f64 { if b < a { return b; } a }
fn max_d(a: f64, b: f64) -> f64 { if a < b { return b; } a }
fn abs_d(x: f64) -> f64 { if x < 0.0 { return 0.0 - x; } x }
fn min_i(a: i32, b: i32) -> i32 { if b < a { return b; } a }
fn sat(x: f64) -> f64 { if x < 0.0 { return 0.0; } if x > 1.0 { return 1.0; } x }

fn u2f(u: u64) -> f64 {
    let mut r: f64 = 0.0; let mut bit: f64 = 1.0; let mut v: u64 = u;
    while v != 0u64 { if (v & 1u64) != 0u64 { r = r + bit; } v = v >> 1u64; bit = bit * 2.0; }
    r
}
fn i2f(n: i32) -> f64 { if n < 0 { return 0.0 - u2f((0 - n) as u64); } u2f(n as u64) }

fn floor_i32(x: f64) -> i32 {
    let neg: bool = x < 0.0; let ax: f64 = if neg { 0.0 - x } else { x };
    let mut rem: f64 = ax; let mut bf: f64 = 65536.0; let mut bi: i32 = 65536;
    let mut out: i32 = 0; let mut k: i32 = 0;
    while k < 17 { if rem >= bf { rem = rem - bf; out = out + bi; } bf = bf * 0.5; bi = bi / 2; k = k + 1; }
    if !neg { return out; }
    if i2f(out) == ax { return 0 - out; }
    0 - out - 1
}

fn w_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0; }
    let mut g: f64 = if x > 1.0 { x * 0.5 } else { 1.0 }; let mut i: i32 = 0;
    while i < 50 { g = 0.5 * (g + x / g); i = i + 1; }
    g
}

fn w_cbrt(x: f64) -> f64 {
    if x == 0.0 { return 0.0; }
    let neg: bool = x < 0.0; let mut m: f64 = if neg { 0.0 - x } else { x };
    let mut sc: f64 = 1.0;
    while m >= 8.0 { m = m * 0.125; sc = sc * 2.0; }
    while m < 1.0 { m = m * 8.0; sc = sc * 0.5; }
    let mut g: f64 = 1.0 + 0.25 * (m - 1.0); let mut i: i32 = 0;
    while i < 14 { g = (2.0 * g + m / (g * g)) / 3.0; i = i + 1; }
    if neg { return 0.0 - g * sc; }
    g * sc
}

fn w_exp(x_in: f64) -> f64 {
    if x_in < -745.0 { return 0.0; }
    let ln2: f64 = 0.693147180559945309417232121458176568;
    let mut p: f64 = x_in; let mut k: i32 = 0;
    while p > 0.34657359027997264 { p = p - ln2; k = k + 1; }
    while p < -0.34657359027997264 { p = p + ln2; k = k - 1; }
    let kf: f64 = i2f(k);
    let r_hi: f64 = x_in - kf * 0.6931471803691238; let r_lo: f64 = kf * 1.9082149292705877e-10;
    let r: f64 = r_hi - r_lo; let t: f64 = r * r;
    let c: f64 = r - t * (0.166666666666666019037 + t * (-2.77777777770155933842e-3
        + t * (6.61375632143793436117e-5 + t * (-1.65339022054652515390e-6
        + t * 4.13813679705723846039e-8))));
    let sum: f64 = 1.0 - ((r_lo - (r * c) / (2.0 - c)) - r_hi);
    let mut sc: f64 = 1.0;
    while k > 0 { sc = sc * 2.0; k = k - 1; }
    while k < 0 { sc = sc * 0.5; k = k + 1; }
    sum * sc
}

fn w_ln(x_in: f64) -> f64 {
    if x_in <= 0.0 { return 0.0; }
    let mut x: f64 = x_in; let mut kf: f64 = 0.0;
    while x > 1.4142135623730951 { x = x * 0.5; kf = kf + 1.0; }
    while x < 0.7071067811865476 { x = x * 2.0; kf = kf - 1.0; }
    let t: f64 = (x - 1.0) / (x + 1.0); let t2: f64 = t * t;
    let mut pw: f64 = t; let mut sum: f64 = 0.0; let mut den: f64 = 1.0; let mut s: i32 = 0;
    while s < 18 { sum = sum + pw / den; pw = pw * t2; den = den + 2.0; s = s + 1; }
    (2.0 * sum + kf * 1.9082149292705877e-10) + kf * 0.6931471803691238
}
fn w_pow(x: f64, y: f64) -> f64 { if x <= 0.0 { return 0.0; } w_exp(y * w_ln(x)) }

fn w_sin_core(r: f64) -> f64 {
    let r2: f64 = r * r; let mut term: f64 = r; let mut sum: f64 = r; let mut n: i32 = 1;
    while n <= 12 { term = (0.0 - term) * r2 / (i2f(2 * n) * i2f(2 * n + 1)); sum = sum + term; n = n + 1; }
    sum
}
fn w_cos_core(r: f64) -> f64 {
    let r2: f64 = r * r; let mut term: f64 = 1.0; let mut sum: f64 = 1.0; let mut n: i32 = 1;
    while n <= 12 { term = (0.0 - term) * r2 / (i2f(2 * n - 1) * i2f(2 * n)); sum = sum + term; n = n + 1; }
    sum
}
fn w_sin(x_in: f64) -> f64 {
    let hpi: f64 = 1.57079632679489661923; let mut q: i32 = 0; let mut p: f64 = x_in;
    while p > 0.7853981633974483 { p = p - hpi; q = q + 1; }
    while p < -0.7853981633974483 { p = p + hpi; q = q - 1; }
    let qf: f64 = i2f(q);
    let r: f64 = (x_in - qf * 1.5707963267341256) - qf * 6.077100506506192e-11;
    let m: i32 = ((q % 4) + 4) % 4;
    if m == 0 { return w_sin_core(r); }
    if m == 1 { return w_cos_core(r); }
    if m == 2 { return 0.0 - w_sin_core(r); }
    0.0 - w_cos_core(r)
}
fn w_cos(x_in: f64) -> f64 {
    let hpi: f64 = 1.57079632679489661923; let mut q: i32 = 0; let mut p: f64 = x_in;
    while p > 0.7853981633974483 { p = p - hpi; q = q + 1; }
    while p < -0.7853981633974483 { p = p + hpi; q = q - 1; }
    let qf: f64 = i2f(q);
    let r: f64 = (x_in - qf * 1.5707963267341256) - qf * 6.077100506506192e-11;
    let m: i32 = ((q % 4) + 4) % 4;
    if m == 0 { return w_cos_core(r); }
    if m == 1 { return 0.0 - w_sin_core(r); }
    if m == 2 { return 0.0 - w_cos_core(r); }
    w_sin_core(r)
}

fn w_atan(x_in: f64) -> f64 {
    let neg: bool = x_in < 0.0; let mut x: f64 = if neg { 0.0 - x_in } else { x_in };
    let inv: bool = x > 1.0; if inv { x = 1.0 / x; }
    let mut s: f64 = 0.0; let mut sh: bool = false;
    if x > 0.2679491924311227 {
        x = (x * 1.7320508075688772 - 1.0) / (1.7320508075688772 + x); sh = true;
    }
    let x2: f64 = x * x; let mut pw: f64 = x; let mut den: f64 = 1.0; let mut k: i32 = 0;
    while k < 14 {
        if (k & 1) == 0 { s = s + pw / den; } else { s = s - pw / den; }
        pw = pw * x2; den = den + 2.0; k = k + 1;
    }
    if sh { s = s + 0.5235987755982989; }
    if inv { s = 1.5707963267948966 - s; }
    if neg { return 0.0 - s; }
    s
}
fn w_atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 { return w_atan(y / x); }
    if x < 0.0 && y >= 0.0 { return w_atan(y / x) + pi_c(); }
    if x < 0.0 && y < 0.0 { return w_atan(y / x) - pi_c(); }
    if y > 0.0 { return 1.5707963267948966; }
    if y < 0.0 { return -1.5707963267948966; }
    0.0
}

fn hypot2(a0: f64, b0: f64) -> f64 {
    let a: f64 = abs_d(a0); let b: f64 = abs_d(b0);
    if a == 0.0 && b == 0.0 { return 0.0; }
    if a >= b { let r: f64 = b / a; return a * w_sqrt(1.0 + r * r); }
    let r: f64 = a / b; b * w_sqrt(1.0 + r * r)
}
fn hypot3(x0: f64, y0: f64, z0: f64) -> f64 {
    let x: f64 = abs_d(x0); let y: f64 = abs_d(y0); let z: f64 = abs_d(z0);
    let mx: f64 = max_d(x, max_d(y, z));
    if mx == 0.0 { return 0.0; }
    let sx: f64 = x / mx; let sy: f64 = y / mx; let sz: f64 = z / mx;
    mx * w_sqrt(sx * sx + sy * sy + sz * sz)
}

fn fnv_u8(h0: u64, b: u64) -> u64 { (h0 ^ b) * 1099511628211u64 }
fn srgb_to_lin(c: f64) -> f64 { if c <= 0.04045 { return c / 12.92; } w_pow((c + 0.055) / 1.055, 2.4) }
fn lin_to_srgb(c: f64) -> f64 { if c <= 0.0031308 { return 12.92 * c; } 1.055 * w_pow(c, 1.0 / 2.4) - 0.055 }
fn byte8(v: f64) -> u64 { floor_i32(min_d(1.0, max_d(0.0, v)) * 255.0 + 0.5) as u64 }

fn toward(h: f64, t: f64, f: f64) -> f64 {
    let pi: f64 = pi_c(); let mut d: f64 = t - h;
    while d > pi { d = d - 2.0 * pi; }
    while d < 0.0 - pi { d = d + 2.0 * pi; }
    h + d * f
}

fn bayer8(x0: i32, y0: i32) -> f64 {
    let x: i32 = x0 & 7; let y: i32 = y0 & 7; let v: i32 = x ^ y;
    let r: i32 = ((v & 1) << 5) | ((y & 1) << 4) | (((v >> 1) & 1) << 3)
        | (((y >> 1) & 1) << 2) | (((v >> 2) & 1) << 1) | ((y >> 2) & 1);
    (i2f(r) + 0.5) / 64.0
}

fn mask_radial(lpx: f64, lpy: f64, lpz: f64, rad: f64, core: f64, inten: f64, px: f64, py: f64, pz: f64) -> f64 {
    let vx: f64 = px - lpx; let vy: f64 = py - lpy; let vz: f64 = pz - lpz;
    let r2: f64 = vx * vx + vy * vy + vz * vz;
    let q: f64 = r2 / (rad * rad);
    if q >= 1.0 { return 0.0; }
    (inten * (1.0 - q) * (1.0 - q)) / (1.0 + r2 / (core * core))
}
fn surf_term(lpx: f64, lpy: f64, lpz: f64, wrap: f64, px: f64, py: f64, pz: f64, nx: f64, ny: f64, nz: f64) -> f64 {
    let vx: f64 = lpx - px; let vy: f64 = lpy - py; let vz: f64 = lpz - pz;
    let lv: f64 = hypot3(vx, vy, vz);
    if lv < 1.0e-6 { return 1.0; }
    sat(((nx * vx + ny * vy + nz * vz) / lv + wrap) / (1.0 + wrap))
}

fn build_pal_rgb(steps: i32, void_steps: i32) -> Vec<u64> {
    let pi: f64 = pi_c(); let d2r: f64 = pi / 180.0;
    let mut rgb: Vec<u64> = Vec::new();
    let mut c: i32 = 0;
    while c < 4 {
        let br: f64 = if c == 0 { 0.34 } else if c == 1 { 0.62 } else if c == 2 { 0.42 } else { 0.2 };
        let bg: f64 = if c == 0 { 0.42 } else if c == 1 { 0.6 } else if c == 2 { 0.29 } else { 0.38 };
        let bb: f64 = if c == 0 { 0.24 } else if c == 1 { 0.58 } else if c == 2 { 0.18 } else { 0.22 };
        let lr: f64 = srgb_to_lin(br); let lg: f64 = srgb_to_lin(bg); let lb: f64 = srgb_to_lin(bb);
        let l: f64 = w_cbrt(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb);
        let m: f64 = w_cbrt(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb);
        let s: f64 = w_cbrt(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb);
        let l0: f64 = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
        let oa0: f64 = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
        let ob0: f64 = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
        let c0: f64 = hypot2(oa0, ob0); let h0: f64 = w_atan2(ob0, oa0);
        let mut v: i32 = 0;
        while v < 2 {
            let mut st: i32 = 0;
            while st < steps {
                let t: f64 = i2f(st) / i2f(steps - 1);
                let mut lv: f64 = min_d(0.97, l0 * (0.34 + 0.86 * w_pow(t, 0.9)));
                let mut cv: f64 = min_d(0.2, c0 * (0.6 + 0.9 * w_sin(pi * (0.15 + 0.8 * t))));
                let mut hv: f64 = toward(h0, 285.0 * d2r, 0.55 * w_pow(1.0 - t, 1.2));
                hv = toward(hv, 85.0 * d2r, 0.4 * w_pow(t, 1.6));
                if v == 0 {
                    hv = toward(hv, 250.0 * d2r, 0.3); lv = lv * 0.97;
                } else {
                    hv = toward(hv, 62.0 * d2r, 0.72 * (0.4 + 0.6 * t));
                    cv = min_d(0.22, cv * 1.3); lv = min_d(0.97, lv * 1.12);
                }
                let oa: f64 = cv * w_cos(hv); let ob: f64 = cv * w_sin(hv);
                let lx: f64 = lv + 0.3963377774 * oa + 0.2158037573 * ob;
                let mx: f64 = lv - 0.1055613458 * oa - 0.0638541728 * ob;
                let sx: f64 = lv - 0.0894841775 * oa - 1.2914855480 * ob;
                let lc: f64 = lx * lx * lx; let mc: f64 = mx * mx * mx; let sc: f64 = sx * sx * sx;
                rgb.push(byte8(sat(lin_to_srgb(4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc))));
                rgb.push(byte8(sat(lin_to_srgb(-1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc))));
                rgb.push(byte8(sat(lin_to_srgb(-0.0041960863 * lc - 0.7034186147 * mc + 1.7076147010 * sc))));
                st = st + 1;
            }
            v = v + 1;
        }
        c = c + 1;
    }
    let mut vs: i32 = 0;
    while vs < void_steps {
        let t: f64 = i2f(vs) / i2f(void_steps);
        let lv: f64 = 0.2 + 0.44 * w_pow(w_sin(pi * t), 1.3) + (if vs == 3 { 0.04 } else { 0.0 });
        let cv: f64 = 0.07 + 0.1 * w_sin(pi * t);
        let hv: f64 = (285.0 + 75.0 * w_sin(2.0 * pi * t) - (if vs == 3 { 40.0 } else { 0.0 })) * d2r;
        let oa: f64 = cv * w_cos(hv); let ob: f64 = cv * w_sin(hv);
        let lx: f64 = lv + 0.3963377774 * oa + 0.2158037573 * ob;
        let mx: f64 = lv - 0.1055613458 * oa - 0.0638541728 * ob;
        let sx: f64 = lv - 0.0894841775 * oa - 1.2914855480 * ob;
        let lc: f64 = lx * lx * lx; let mc: f64 = mx * mx * mx; let sc: f64 = sx * sx * sx;
        rgb.push(byte8(sat(lin_to_srgb(4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc))));
        rgb.push(byte8(sat(lin_to_srgb(-1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc))));
        rgb.push(byte8(sat(lin_to_srgb(-0.0041960863 * lc - 0.7034186147 * mc + 1.7076147010 * sc))));
        vs = vs + 1;
    }
    let mut e_l: Vec<f64> = Vec::new(); let mut e_c: Vec<f64> = Vec::new(); let mut e_h: Vec<f64> = Vec::new();
    e_l.push(0.7); e_c.push(0.13); e_h.push(70.0 * d2r);
    e_l.push(0.83); e_c.push(0.12); e_h.push(85.0 * d2r);
    e_l.push(0.95); e_c.push(0.08); e_h.push(95.0 * d2r);
    e_l.push(0.9); e_c.push(0.1); e_h.push(90.0 * d2r);
    e_l.push(0.98); e_c.push(0.05); e_h.push(100.0 * d2r);
    e_l.push(0.14); e_c.push(0.04); e_h.push(285.0 * d2r);
    let mut ei: i32 = 0;
    while ei < 6 {
        let lv: f64 = e_l[ei as usize]; let cv: f64 = e_c[ei as usize]; let hv: f64 = e_h[ei as usize];
        let oa: f64 = cv * w_cos(hv); let ob: f64 = cv * w_sin(hv);
        let lx: f64 = lv + 0.3963377774 * oa + 0.2158037573 * ob;
        let mx: f64 = lv - 0.1055613458 * oa - 0.0638541728 * ob;
        let sx: f64 = lv - 0.0894841775 * oa - 1.2914855480 * ob;
        let lc: f64 = lx * lx * lx; let mc: f64 = mx * mx * mx; let sc: f64 = sx * sx * sx;
        rgb.push(byte8(sat(lin_to_srgb(4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc))));
        rgb.push(byte8(sat(lin_to_srgb(-1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc))));
        rgb.push(byte8(sat(lin_to_srgb(-0.0041960863 * lc - 0.7034186147 * mc + 1.7076147010 * sc))));
        ei = ei + 1;
    }
    rgb
}

fn hash_pal_only(steps: i32, void_steps: i32, h0: u64) -> u64 {
    let rgb: Vec<u64> = build_pal_rgb(steps, void_steps);
    let n: i32 = rgb.len() as i32; let mut h: u64 = h0; let mut i: i32 = 0;
    while i < n { h = fnv_u8(h, rgb[i as usize]); i = i + 1; }
    h
}

fn run_frame(steps: i32, void_steps: i32, amb_base: f64, time: f64, h0: u64) -> u64 {
    let rgb: Vec<u64> = build_pal_rgb(steps, void_steps);
    let void_off: i32 = 8 * steps;
    let win_off: i32 = void_off + void_steps;
    let lamp_off: i32 = win_off + 3;
    let night: i32 = lamp_off + 2;
    let ml: f64 = hypot3(-0.5, 0.68, 0.5);
    let mx: f64 = -0.5 / ml; let my: f64 = 0.68 / ml; let mz: f64 = 0.5 / ml;
    let w: i32 = 48; let h: i32 = 32;
    let mut idx_out: Vec<i32> = Vec::new();
    let mut rgba_out: Vec<u64> = Vec::new();
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let t1: f64 = bayer8(x, y); let t2: f64 = bayer8(x + 11, y + 7);
            let mut k: i32 = night;
            if y >= 4 {
                let px: f64 = ((-8.0 + 16.0 * (i2f(x) / 48.0)) as f32) as f64;
                let py: f64 = ((4.0 * (1.0 - i2f(y) / 32.0)) as f32) as f64;
                let pz: f64 = ((2.0 * (i2f(y) / 32.0) - 0.5) as f32) as f64;
                let mut nx0: f64 = 0.0; let mut ny0: f64 = 1.0; let mut nz0: f64 = 0.0;
                let mut cls: i32 = 0;
                if y >= 20 {
                    cls = 0; nx0 = 0.1 * w_sin((-8.0 + 16.0 * (i2f(x) / 48.0)) * 0.5); ny0 = 0.98; nz0 = 0.15;
                }
                else if x < 16 { cls = 1; nx0 = 0.25; ny0 = 0.20; nz0 = 0.95; }
                else if x < 28 { cls = 2; nx0 = -0.20; ny0 = 0.35; nz0 = 0.91; }
                else if x < 38 { cls = 3; nx0 = 0.40 * w_cos(i2f(y)); ny0 = 0.70; nz0 = 0.58; }
                else if y < 12 { cls = 4; } else if y < 16 { cls = 5; } else { cls = 6; }
                let nl: f64 = w_sqrt(nx0 * nx0 + ny0 * ny0 + nz0 * nz0);
                let nx: f64 = ((nx0 / nl) as f32) as f64;
                let ny: f64 = ((ny0 / nl) as f32) as f64;
                let nz: f64 = ((nz0 / nl) as f32) as f64;
                let a_v: f64 = ((0.45 + 0.50 * (i2f(x) / 48.0)) as f32) as f64;
                let phv: f64 = ((i2f(x + y) / 80.0) as f32) as f64;
                let v0: f64 = ((if ((x + y) % 5) == 0 { 0.35 } else { 1.0 }) as f32) as f64;
                let v1: f64 = ((if x > 6 && x < 42 { 0.95 } else { 0.25 }) as f32) as f64;
                let v2: f64 = ((if x < 24 { 0.85 } else { 0.15 }) as f32) as f64;
                if cls == 4 {
                    let vsf: f64 = i2f(void_steps);
                    let a_m: f64 = phv * vsf + time * 0.18 * vsf;
                    let pos_v: f64 = a_m - i2f(floor_i32(a_m / vsf)) * vsf;
                    let lo: i32 = floor_i32(pos_v);
                    let vi: i32 = (if pos_v - i2f(lo) > t1 { lo + 1 } else { lo }) % void_steps;
                    k = void_off + vi;
                } else if cls == 5 {
                    let sv: f64 = 1.4 + 0.6 * w_sin(time * 5.0 + px * 3.0) + 0.4 * (a_v - 0.5);
                    let tone: f64 = min_d(2.0, max_d(0.0, sv));
                    let lo: i32 = min_i(1, floor_i32(tone));
                    k = win_off + (if tone - i2f(lo) > t1 { lo + 1 } else { lo });
                } else if cls == 6 {
                    k = lamp_off + (if (0.5 + 0.2 * w_sin(time * 7.0)) > t1 { 1 } else { 0 });
                } else {
                    let ndl: f64 = max_d(0.0, nx * mx + ny * my + nz * mz);
                    let cool: f64 = 0.08 * (amb_base + 0.3 * (0.5 + 0.5 * ny)) + 0.45 * ndl * v0;
                    let mut warm: f64 = 0.0;
                    let m0: f64 = mask_radial(1.5, 2.2, 1.4, 11.0, 1.6, 6.0, px, py, pz);
                    if m0 > 0.0 { warm = warm + v1 * m0 * surf_term(1.5, 2.2, 1.4, 0.25, px, py, pz, nx, ny, nz); }
                    let q0: f64 = mask_radial(-6.0, 2.2, 1.22, 6.0, 1.0, 1.3, px, py, pz);
                    if q0 > 0.0 { warm = warm + v2 * q0 * surf_term(-6.0, 2.2, 1.22, 0.5, px, py, pz, nx, ny, nz); }
                    let q1: f64 = mask_radial(-3.0, 2.2, 1.22, 6.0, 1.0, 1.3, px, py, pz);
                    if q1 > 0.0 { warm = warm + v2 * q1 * surf_term(-3.0, 2.2, 1.22, 0.5, px, py, pz, nx, ny, nz); }
                    let e_tot: f64 = cool + warm;
                    let tone: f64 = 1.0 - w_exp(-1.5 * e_tot * a_v);
                    let s_v: f64 = min_d(i2f(steps - 1), max_d(0.0, tone * i2f(steps - 1)));
                    let w_r: f64 = if e_tot > 1.0e-9 { warm / e_tot } else { 0.0 };
                    let lo: i32 = min_i(steps - 2, floor_i32(s_v));
                    let step: i32 = if s_v - i2f(lo) > t1 { lo + 1 } else { lo };
                    let var: i32 = if w_r >= 0.7 { 1 } else if w_r <= 0.3 { 0 }
                        else if (w_r - 0.3) / 0.4 > t2 { 1 } else { 0 };
                    k = (cls * 2 + var) * steps + step;
                }
            }
            idx_out.push(k);
            rgba_out.push(rgb[(k * 3) as usize]);
            rgba_out.push(rgb[(k * 3 + 1) as usize]);
            rgba_out.push(rgb[(k * 3 + 2) as usize]);
            rgba_out.push(255u64);
            x = x + 1;
        }
        y = y + 1;
    }
    let mut hash: u64 = h0; let mut ii: i32 = 0;
    while ii < w * h { hash = fnv_u8(hash, (idx_out[ii as usize] & 255) as u64); ii = ii + 1; }
    let mut ri: i32 = 0;
    while ri < w * h * 4 { hash = fnv_u8(hash, rgba_out[ri as usize]); ri = ri + 1; }
    hash
}

// mode: 0=palettes, 1=t0, 2=t1, 3=s6, 4=all, 5=ctrl(amb=0)
pub fn palettelight_hash(mode: i32) -> u64 {
    let seed: u64 = 1469598103934665603u64;
    if mode == 0 { return hash_pal_only(6, 8, hash_pal_only(4, 6, seed)); }
    if mode == 1 { return run_frame(4, 6, 0.7, 0.0, seed); }
    if mode == 2 { return run_frame(4, 6, 0.7, 1.75, seed); }
    if mode == 3 { return run_frame(6, 8, 0.7, 0.85, seed); }
    if mode == 5 { return run_frame(4, 6, 0.0, 0.0, seed); }
    let h1: u64 = hash_pal_only(6, 8, hash_pal_only(4, 6, seed));
    let h2: u64 = run_frame(4, 6, 0.7, 0.0, h1);
    let h3: u64 = run_frame(4, 6, 0.7, 1.75, h2);
    run_frame(6, 8, 0.7, 0.85, h3)
}

fn main() -> i32 { 0 }
