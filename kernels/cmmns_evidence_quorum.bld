//
// Wave 95D (Formula SIG-156, Author Ideas F1/N49/N32):
//   Byzantine-Fault-Tolerant 3f+1 Independent-Verifier Evidence Quorum Consensus.
//   Pins verifier attestations via pure FIPS 180-4 SHA-256, requires >= 2f+1 distinct
//   honest verifiers on n >= 3f+1 committees, and rejects colluding minorities (-501),
//   Sybil duplicate verifier IDs (-502), and invalid BFT bounds/forged digests (-503).

fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn add32(a: u32, b: u32) -> u32 {
    (((a as u64) + (b as u64)) & 4294967295) as u32
}

fn sha256_k() -> Vec<u32> {
    let mut k: Vec<u32> = Vec::new();
    k.push(1116352408); k.push(1899447441); k.push(3049323471); k.push(3921009573);
    k.push(961987163);  k.push(1508970993); k.push(2453635748); k.push(2870763221);
    k.push(3624381080); k.push(310598401);  k.push(607225278);  k.push(1426881987);
    k.push(1925078388); k.push(2162078206); k.push(2614888103); k.push(3248222580);
    k.push(3835390401); k.push(4022224774); k.push(264347078);  k.push(604807628);
    k.push(770255983);  k.push(1249150122); k.push(1555081692); k.push(1996064986);
    k.push(2554220882); k.push(2821834349); k.push(2952996808); k.push(3210313671);
    k.push(3336571891); k.push(3584528711); k.push(113926993);  k.push(338241895);
    k.push(666307205);  k.push(773529912);  k.push(1294757372); k.push(1396182291);
    k.push(1695183700); k.push(1986661051); k.push(2177026350); k.push(2456956037);
    k.push(2730485921); k.push(2820302411); k.push(3259730800); k.push(3345764771);
    k.push(3516065817); k.push(3600352804); k.push(4094571909); k.push(275423344);
    k.push(430227734);  k.push(506948616);  k.push(659060556);  k.push(883997877);
    k.push(958139571);  k.push(1322822218); k.push(1537002063); k.push(1747873779);
    k.push(1955562222); k.push(2024104815); k.push(2227730452); k.push(2361852424);
    k.push(2428436474); k.push(2756734187); k.push(3204031479); k.push(3329325298);
    k
}

fn sha256_bytes(msg: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let mut padded: Vec<u32> = Vec::new();
    let msg_len: usize = msg.len();
    let mut i: usize = 0;
    while i < msg_len {
        padded.push(msg[i] & 255);
        i = i + 1;
    }
    padded.push(128);
    while (padded.len() % 64) != 56 {
        padded.push(0);
    }
    let bit_len: u64 = (msg_len as u64) * 8;
    let mut sh: i32 = 56;
    while sh >= 0 {
        padded.push(((bit_len >> (sh as u64)) & 255) as u32);
        sh = sh - 8;
    }

    let mut h0: u32 = 1779033703; let mut h1: u32 = 3144134277;
    let mut h2: u32 = 1013904242; let mut h3: u32 = 2773480762;
    let mut h4: u32 = 1359893119; let mut h5: u32 = 2600822924;
    let mut h6: u32 = 528734635;  let mut h7: u32 = 1541459225;

    let mut w: Vec<u32> = Vec::new();
    i = 0;
    while i < 64 { w.push(0); i = i + 1; }

    let total_len: usize = padded.len();
    let mut blk: usize = 0;
    while blk < total_len {
        let mut t: usize = 0;
        while t < 16 {
            let b: usize = blk + t * 4;
            w[t] = (padded[b] << 24)
                | (padded[b + 1] << 16)
                | (padded[b + 2] << 8)
                | padded[b + 3];
            t = t + 1;
        }
        while t < 64 {
            let s0: u32 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: u32 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = add32(add32(w[t - 16], s0), add32(w[t - 7], s1));
            t = t + 1;
        }
        let mut a: u32 = h0; let mut b: u32 = h1; let mut c: u32 = h2; let mut d: u32 = h3;
        let mut e: u32 = h4; let mut f: u32 = h5; let mut g: u32 = h6; let mut h: u32 = h7;
        t = 0;
        while t < 64 {
            let s1: u32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: u32 = (e & f) ^ ((e ^ 4294967295) & g);
            let tmp1: u32 = add32(add32(add32(h, s1), add32(ch, k_tbl[t])), w[t]);
            let s0: u32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
            let tmp2: u32 = add32(s0, maj);
            h = g; g = f; f = e; e = add32(d, tmp1);
            d = c; c = b; b = a; a = add32(tmp1, tmp2);
            t = t + 1;
        }
        h0 = add32(h0, a); h1 = add32(h1, b); h2 = add32(h2, c); h3 = add32(h3, d);
        h4 = add32(h4, e); h5 = add32(h5, f); h6 = add32(h6, g); h7 = add32(h7, h);
        blk = blk + 64;
    }
    vec![h0, h1, h2, h3, h4, h5, h6, h7]
}

fn hex_nibble(n: u32) -> String {
    let digits: String = "0123456789abcdef";
    digits.char_at((n & 15) as usize)
}

fn words_to_hex(ws: &Vec<u32>) -> String {
    let mut hex: String = "";
    let mut i: usize = 0;
    while i < 8 {
        let w: u32 = ws[i];
        let mut sh: i32 = 28;
        while sh >= 0 {
            hex = format!("{}{}", hex, hex_nibble((w >> (sh as u32)) & 15));
            sh = sh - 4;
        }
        i = i + 1;
    }
    hex
}

fn push_u32_be(buf: &mut Vec<u32>, v: u32) {
    buf.push((v >> 24) & 255);
    buf.push((v >> 16) & 255);
    buf.push((v >> 8) & 255);
    buf.push(v & 255);
}

fn attest_digest(claim_id: u32, payload_hash: u32, verifier_id: u32, k_tbl: &Vec<u32>) -> u32 {
    let mut buf: Vec<u32> = Vec::new();
    push_u32_be(&mut buf, claim_id);
    push_u32_be(&mut buf, payload_hash);
    push_u32_be(&mut buf, verifier_id);
    let ws: Vec<u32> = sha256_bytes(&buf, k_tbl);
    ws[0]
}

struct QuorumRes {
    rc: i32,
    agree_count: i32,
    quorum_need: i32,
    pinned_hex: String,
}

// Fail-closed 3f+1 BFT evidence quorum gate:
// 0=QUORUM_VERIFIED, -501=COLLUDING_MINORITY_BELOW_2F_PLUS_1,
// -502=SYBIL_DUPLICATE_VERIFIER, -503=INVALID_BFT_BOUNDS_OR_FORGED_DIGEST
fn evaluate_bft_quorum(
    f_faults: i32,
    claim_id: u32,
    expected_payload: u32,
    verifier_ids: &Vec<u32>,
    reported_payloads: &Vec<u32>,
    reported_sigs: &Vec<u32>,
    k_tbl: &Vec<u32>,
) -> QuorumRes {
    let n: usize = verifier_ids.len();
    let min_n: i32 = 3 * f_faults + 1;
    let q_need: i32 = 2 * f_faults + 1;
    if f_faults < 1 || (n as i32) < min_n || reported_payloads.len() != n || reported_sigs.len() != n {
        return QuorumRes { rc: -503, agree_count: 0, quorum_need: q_need, pinned_hex: "" };
    }

    // Reject Sybil duplicate verifier IDs fail-closed
    let mut i: usize = 0;
    while i < n {
        let mut j: usize = i + 1;
        while j < n {
            if verifier_ids[i] == verifier_ids[j] {
                return QuorumRes { rc: -502, agree_count: 0, quorum_need: q_need, pinned_hex: "" };
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Count honest matching attestations with valid SHA-256 commitment
    let mut agree: i32 = 0;
    let mut pin_buf: Vec<u32> = Vec::new();
    push_u32_be(&mut pin_buf, claim_id);
    push_u32_be(&mut pin_buf, expected_payload);
    i = 0;
    while i < n {
        let vid: u32 = verifier_ids[i];
        let pay: u32 = reported_payloads[i];
        let sig: u32 = reported_sigs[i];
        let exp_sig: u32 = attest_digest(claim_id, pay, vid, k_tbl);
        if sig != exp_sig {
            return QuorumRes { rc: -503, agree_count: agree, quorum_need: q_need, pinned_hex: "" };
        }
        if pay == expected_payload {
            agree = agree + 1;
            push_u32_be(&mut pin_buf, vid);
            push_u32_be(&mut pin_buf, sig);
        }
        i = i + 1;
    }

    if agree < q_need {
        return QuorumRes { rc: -501, agree_count: agree, quorum_need: q_need, pinned_hex: "" };
    }
    let root_ws: Vec<u32> = sha256_bytes(&pin_buf, k_tbl);
    QuorumRes { rc: 0, agree_count: agree, quorum_need: q_need, pinned_hex: words_to_hex(&root_ws) }
}

fn main() ~ Clock + Console {
    let t0: i64 = clock_ns();
    let k_tbl: Vec<u32> = sha256_k();
    let claim_id: u32 = 9501;
    let good_pay: u32 = 3735928559;
    let bad_pay: u32 = 3405691582;

    // 1. Clean f=1 BFT committee (n=4, q=3): 3 honest + 1 Byzantine dissenter
    let v_f1: Vec<u32> = vec![101, 102, 103, 104];
    let p_f1: Vec<u32> = vec![good_pay, good_pay, good_pay, bad_pay];
    let s_f1: Vec<u32> = vec![
        attest_digest(claim_id, good_pay, 101, &k_tbl),
        attest_digest(claim_id, good_pay, 102, &k_tbl),
        attest_digest(claim_id, good_pay, 103, &k_tbl),
        attest_digest(claim_id, bad_pay, 104, &k_tbl),
    ];
    let r_f1: QuorumRes = evaluate_bft_quorum(1, claim_id, good_pay, &v_f1, &p_f1, &s_f1, &k_tbl);

    // 2. Clean f=2 BFT committee (n=7, q=5): 5 honest + 2 Byzantine dissenters
    let v_f2: Vec<u32> = vec![201, 202, 203, 204, 205, 206, 207];
    let p_f2: Vec<u32> = vec![good_pay, good_pay, good_pay, good_pay, good_pay, bad_pay, bad_pay];
    let mut s_f2: Vec<u32> = Vec::new();
    let mut idx: usize = 0;
    while idx < 7 {
        s_f2.push(attest_digest(claim_id, p_f2[idx], v_f2[idx], &k_tbl));
        idx = idx + 1;
    }
    let r_f2: QuorumRes = evaluate_bft_quorum(2, claim_id, good_pay, &v_f2, &p_f2, &s_f2, &k_tbl);

    // Planted control 1: Colluding minority (only 2/4 honest < q=3) -> -501
    let p_min: Vec<u32> = vec![good_pay, good_pay, bad_pay, bad_pay];
    let mut s_min: Vec<u32> = Vec::new();
    idx = 0;
    while idx < 4 {
        s_min.push(attest_digest(claim_id, p_min[idx], v_f1[idx], &k_tbl));
        idx = idx + 1;
    }
    let r_min: QuorumRes = evaluate_bft_quorum(1, claim_id, good_pay, &v_f1, &p_min, &s_min, &k_tbl);

    // Planted control 2: Sybil duplicate verifier ID 101 padding quorum -> -502
    let v_syb: Vec<u32> = vec![101, 101, 102, 104];
    let s_syb: Vec<u32> = vec![
        attest_digest(claim_id, good_pay, 101, &k_tbl),
        attest_digest(claim_id, good_pay, 101, &k_tbl),
        attest_digest(claim_id, good_pay, 102, &k_tbl),
        attest_digest(claim_id, bad_pay, 104, &k_tbl),
    ];
    let r_syb: QuorumRes = evaluate_bft_quorum(1, claim_id, good_pay, &v_syb, &p_f1, &s_syb, &k_tbl);

    // Planted control 3: Forged attestation signature (1-bit flip) -> -503
    let mut s_forg: Vec<u32> = vec![s_f1[0], s_f1[1], s_f1[2] ^ 1, s_f1[3]];
    let r_forg: QuorumRes = evaluate_bft_quorum(1, claim_id, good_pay, &v_f1, &p_f1, &s_forg, &k_tbl);

    // Planted control 4: Under-provisioned committee n=3 < 3*1+1 -> -503
    let v_small: Vec<u32> = vec![101, 102, 103];
    let p_small: Vec<u32> = vec![good_pay, good_pay, good_pay];
    let s_small: Vec<u32> = vec![s_f1[0], s_f1[1], s_f1[2]];
    let r_small: QuorumRes = evaluate_bft_quorum(
        1, claim_id, good_pay, &v_small, &p_small, &s_small, &k_tbl,
    );

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    let mut failures: i32 = 0;
    if r_f1.rc != 0 || r_f1.agree_count != 3 || r_f2.rc != 0 || r_f2.agree_count != 5 {
        failures = failures + 1;
    }
    if r_min.rc != -501 || r_syb.rc != -502 || r_forg.rc != -503 || r_small.rc != -503 {
        failures = failures + 1;
    }

    let p1: String = format!(
        "EVIDENCE_QUORUM status={} failures={} elapsed_ms={:.4} f1_agree={}/{} f2_agree={}/{}",
        if failures == 0 { "PASS" } else { "FAIL" },
        failures,
        elapsed_ms,
        r_f1.agree_count,
        r_f1.quorum_need,
        r_f2.agree_count,
        r_f2.quorum_need
    );
    let p2: String = format!(
        "pin_f1={} rc_min={} rc_syb={} rc_forg={} rc_small={}",
        r_f1.pinned_hex, r_min.rc, r_syb.rc, r_forg.rc, r_small.rc
    );
    println!("{} {}", p1, p2);
}
