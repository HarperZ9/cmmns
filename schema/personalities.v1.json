{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radar:personalities:v1",
  "title": "CMMNS personalities table, version 1",
  "description": "src/ext/personalities.json: documented backing of public media personalities, built by scripts/personalities-build.mjs. Every row quotes its sources, gives the date each was read and says what it does not prove. There is no field for a person's political position, and none for private data. data/personalities.README.md documents the method.",
  "type": "object",
  "required": ["about", "built", "wikidataFetched", "quotesChecked", "people"],
  "additionalProperties": false,
  "properties": {
    "about": { "type": "string", "minLength": 20 },
    "built": { "$ref": "#/$defs/day" },
    "wikidataFetched": { "$ref": "#/$defs/day" },
    "quotesChecked": { "$ref": "#/$defs/day" },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } }
  },
  "$defs": {
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "text": { "type": "string", "minLength": 2 },
    "person": {
      "type": "object",
      "required": ["id", "name", "role", "country", "accounts", "channels", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$" },
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "country": { "type": ["string", "null"] },
        "accounts": {
          "type": "array",
          "items": { "type": "array", "prefixItems": [{ "enum": ["x", "youtube", "tiktok", "instagram", "facebook", "bluesky", "threads"] }, { "type": "string", "minLength": 1 }], "minItems": 2, "maxItems": 2 }
        },
        "channels": { "type": "array", "items": { "type": "string", "pattern": "^UC[A-Za-z0-9_-]{20,24}$" } },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
        "wikidata": {
          "type": "object",
          "required": ["qid", "employers", "fetched"],
          "additionalProperties": false,
          "properties": {
            "qid": { "type": "string", "pattern": "^Q\\d+$" },
            "fetched": { "$ref": "#/$defs/day" },
            "employers": { "type": "array", "items": { "type": "object", "required": ["label", "start", "end"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "start": { "type": ["string", "null"] }, "end": { "type": ["string", "null"] } } } }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["kind", "who", "summary", "period", "status", "confidence", "sources", "doesNotProve"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["employer", "outlet owner", "investor", "licensing deal", "network", "sponsor", "paid promotion", "government advertising", "grant", "nonprofit funding", "state funding", "public funding", "FARA filing", "court record", "sanction", "campaign finance", "lobbying", "platform label", "government label", "investigative reporting"] },
        "who": { "$ref": "#/$defs/text" },
        "summary": { "type": "string", "minLength": 20 },
        "period": { "type": ["string", "null"] },
        "status": { "enum": ["documented", "reported", "alleged"] },
        "confidence": { "enum": ["high", "moderate", "low"] },
        "via": { "type": "string", "description": "The outlet whose owner or backer this row describes, when the row comes from the outlet's record." },
        "doesNotProve": { "type": "string", "minLength": 20 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "campaign": { "type": "object", "required": ["name", "contentType"], "properties": { "name": { "type": "string" }, "contentType": { "type": "string" }, "dates": { "type": ["string", "null"] }, "techniques": { "type": "array", "items": { "type": "string" } } } },
        "correction": { "type": "object", "required": ["source", "checked", "reason"], "properties": { "source": { "type": "string" }, "checked": { "$ref": "#/$defs/day" }, "reason": { "type": "string" } } }
      }
    },
    "source": {
      "type": "object",
      "required": ["publisher", "title", "url", "date", "read", "kind", "quote", "check"],
      "additionalProperties": false,
      "properties": {
        "publisher": { "$ref": "#/$defs/text" },
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "date": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
        "read": { "$ref": "#/$defs/day" },
        "kind": { "enum": ["self", "company", "court", "government", "filing", "platform", "press", "researcher"] },
        "quote": { "type": "string", "minLength": 2 },
        "check": { "enum": ["exact", "loose"], "description": "The quote check found the quote on the page word for word (exact) or with only punctuation or spacing different (loose)." }
      }
    }
  }
}
