{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarperZ9/cmmns/catalogue/schema/definition.v1.json",
  "title": "CMMNS definition catalogue entry, version 1",
  "description": "One published definition, quoted from its official source, split into elements that CMMNS compares with visible conduct. Checked by src/core/definitions-schema.js and tests/definitions.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "verification", "role", "title", "jurisdiction", "instrument", "section", "kind", "binding_note", "in_force", "sources", "quotes", "elements", "does_not_prove", "related"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$", "description": "Stable id. Equals the file name without .json." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Entry version. Any change to quotes, elements or signals bumps it, with a line in catalogue/CHANGELOG.md." },
    "status": { "enum": ["active", "withdrawn"] },
    "verification": { "enum": ["verified", "unverified"], "description": "verified: every quote was checked against the retrieved source. unverified: the source could not be retrieved; such an entry carries no quotes and is never matched." },
    "role": { "enum": ["match", "comparison", "context"], "description": "match: a definition aimed at the conduct. comparison: a broader definition shown beside it, such as fraud. context: a duty of someone else, such as a platform." },
    "title": { "type": "string", "minLength": 5 },
    "jurisdiction": {
      "type": "object", "additionalProperties": false, "required": ["code", "name"],
      "properties": { "code": { "type": "string", "pattern": "^(US|EU|UK|UK-EW-NI|platform:[a-z]+)$" }, "name": { "type": "string" } }
    },
    "instrument": { "type": "string", "minLength": 5 },
    "section": { "type": "string", "minLength": 2 },
    "kind": { "enum": ["statute", "regulation", "directive", "agency-guides", "platform-policy"] },
    "binding_note": { "type": "string", "minLength": 20 },
    "in_force": {
      "type": "object", "additionalProperties": false, "required": ["status", "since", "note"],
      "properties": {
        "status": { "enum": ["in force", "published", "repealed", "not yet in force"] },
        "since": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "retrieved_url", "retrieved_at", "sha256", "hash_method", "retrieved_with", "publisher"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "retrieved_url": { "type": "string", "pattern": "^https://" },
          "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "hash_method": { "enum": ["raw-bytes", "rendered-text"], "description": "raw-bytes: SHA-256 of the response body as retrieved. rendered-text: SHA-256 of the UTF-8 text of the rendered main element, used only when the raw response was a changing bot challenge." },
          "retrieved_with": { "enum": ["curl", "browser"] },
          "publisher": { "type": "string" },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the source's visible text, normalised by htmlText in scripts/catalogue-refetch.mjs. Some servers reorder XML attributes between requests, so drift checks compare this as well as the raw bytes." },
          "note": { "type": "string" }
        }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "locator", "text"],
        "properties": { "source": { "type": "integer", "minimum": 0 }, "locator": { "type": "string" }, "text": { "type": "string", "minLength": 20 } }
      }
    },
    "elements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "observable_from", "required", "strength", "signals"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]$" },
          "label": { "type": "string", "minLength": 5 },
          "observable_from": { "enum": ["page", "public-record", "not-observable"] },
          "required": { "type": "boolean" },
          "strength": { "enum": ["direct", "indicative"], "description": "indicative: the signals are consistent with the element without showing it." },
          "signals": { "type": "array", "items": { "type": "string" }, "description": "Signal ids from catalogue/signals.json. Any one matches, subject to min_families." },
          "min_families": { "type": "integer", "minimum": 2, "description": "Independent signal families needed before the element shows as matched." },
          "note": { "type": "string" }
        }
      }
    },
    "does_not_prove": { "type": "string", "minLength": 40 },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
