;; Radar's matrix product for the text recogniser, in WebAssembly with 128-bit SIMD.
;; out (O x P) = w (O x K) . col (K x P) + bias, all f32, row-major, byte offsets into memory.
;; O must be a multiple of 4 and P a multiple of 8 (the caller pads). Each step computes a
;; 4 x 8 tile: two vectors of columns, four weight rows, eight accumulators.
;; Assembled by scripts/ocr/build-wasm.mjs into src/ocr/gemm-wasm.js.
(module
  (import "env" "memory" (memory 1))
  (func (export "gemm") (param $w i32) (param $col i32) (param $b i32) (param $out i32)
                        (param $O i32) (param $K i32) (param $P i32)
    (local $o i32) (local $p i32) (local $k i32)
    (local $wr i32) (local $cp i32) (local $op i32) (local $rowK i32) (local $rowP i32)
    (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128)
    (local $a4 v128) (local $a5 v128) (local $a6 v128) (local $a7 v128)
    (local $c0 v128) (local $c1 v128) (local $v v128)
    (local.set $rowK (i32.shl (local.get $K) (i32.const 2)))
    (local.set $rowP (i32.shl (local.get $P) (i32.const 2)))
    (local.set $o (i32.const 0))
    (block $done_o (loop $loop_o
      (br_if $done_o (i32.ge_u (local.get $o) (local.get $O)))
      (local.set $p (i32.const 0))
      (block $done_p (loop $loop_p
        (br_if $done_p (i32.ge_u (local.get $p) (local.get $P)))
        ;; accumulators start at the bias of each row
        (local.set $a0 (f32x4.splat (f32.load (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))))
        (local.set $a1 (local.get $a0))
        (local.set $a2 (f32x4.splat (f32.load offset=4 (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))))
        (local.set $a3 (local.get $a2))
        (local.set $a4 (f32x4.splat (f32.load offset=8 (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))))
        (local.set $a5 (local.get $a4))
        (local.set $a6 (f32x4.splat (f32.load offset=12 (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))))
        (local.set $a7 (local.get $a6))
        (local.set $wr (i32.add (local.get $w) (i32.mul (local.get $o) (local.get $rowK))))
        (local.set $cp (i32.add (local.get $col) (i32.shl (local.get $p) (i32.const 2))))
        (local.set $k (i32.const 0))
        (block $done_k (loop $loop_k
          (br_if $done_k (i32.ge_u (local.get $k) (local.get $K)))
          (local.set $c0 (v128.load (local.get $cp)))
          (local.set $c1 (v128.load offset=16 (local.get $cp)))
          (local.set $v (f32x4.splat (f32.load (local.get $wr))))
          (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (local.get $v) (local.get $c0))))
          (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (local.get $v) (local.get $c1))))
          (local.set $v (f32x4.splat (f32.load (i32.add (local.get $wr) (local.get $rowK)))))
          (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (local.get $v) (local.get $c0))))
          (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (local.get $v) (local.get $c1))))
          (local.set $v (f32x4.splat (f32.load (i32.add (local.get $wr) (i32.shl (local.get $rowK) (i32.const 1))))))
          (local.set $a4 (f32x4.add (local.get $a4) (f32x4.mul (local.get $v) (local.get $c0))))
          (local.set $a5 (f32x4.add (local.get $a5) (f32x4.mul (local.get $v) (local.get $c1))))
          (local.set $v (f32x4.splat (f32.load (i32.add (local.get $wr) (i32.mul (local.get $rowK) (i32.const 3))))))
          (local.set $a6 (f32x4.add (local.get $a6) (f32x4.mul (local.get $v) (local.get $c0))))
          (local.set $a7 (f32x4.add (local.get $a7) (f32x4.mul (local.get $v) (local.get $c1))))
          (local.set $wr (i32.add (local.get $wr) (i32.const 4)))
          (local.set $cp (i32.add (local.get $cp) (local.get $rowP)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $loop_k)))
        (local.set $op (i32.add (local.get $out) (i32.add (i32.mul (local.get $o) (local.get $rowP)) (i32.shl (local.get $p) (i32.const 2)))))
        (v128.store (local.get $op) (local.get $a0))
        (v128.store offset=16 (local.get $op) (local.get $a1))
        (local.set $op (i32.add (local.get $op) (local.get $rowP)))
        (v128.store (local.get $op) (local.get $a2))
        (v128.store offset=16 (local.get $op) (local.get $a3))
        (local.set $op (i32.add (local.get $op) (local.get $rowP)))
        (v128.store (local.get $op) (local.get $a4))
        (v128.store offset=16 (local.get $op) (local.get $a5))
        (local.set $op (i32.add (local.get $op) (local.get $rowP)))
        (v128.store (local.get $op) (local.get $a6))
        (v128.store offset=16 (local.get $op) (local.get $a7))
        (local.set $p (i32.add (local.get $p) (i32.const 8)))
        (br $loop_p)))
      (local.set $o (i32.add (local.get $o) (i32.const 4)))
      (br $loop_o)))))
