{
  "manifest_version": 3,
  "name": "Daylight Commons",
  "version": "3.6.1",
  "description": "See the evidence behind social media replies: where accounts are based, coordination and fact-checks, each with its source.",
  "homepage_url": "https://github.com/HarperZ9/daylight-commons",
  "icons": {
    "16": "icons/radar-16.png",
    "32": "icons/radar-32.png",
    "48": "icons/radar-48.png",
    "128": "icons/radar-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "declarativeNetRequest",
    "downloads",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://bsky.app/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "core.bundle.js",
      "lifecycle.js",
      "instances.js",
      "packs-bg.js",
      "sources-bg.js",
      "evidence-bg.js",
      "head-bg.js",
      "ocr.bundle.js",
      "ocr-bg.js",
      "media-store.js",
      "quick-save-bg.js",
      "quick-hover-bg.js",
      "side-bg.js",
      "card-bg.js",
      "media-bg.js",
      "adblock-bg.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "sniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ytsniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "bskysniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "fedisniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://bsky.app/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "core.bundle.js",
        "guard.js",
        "settings.js",
        "lens-inline.js",
        "fonts.js",
        "store.js",
        "feedback.js",
        "meta.js",
        "about-page.js",
        "platforms-reach.js",
        "platforms.js",
        "tour.js",
        "side-bridge.js",
        "pop.js",
        "media.js",
        "mediacard.js",
        "linkcard.js",
        "signals.js",
        "definitions-view.js",
        "freshness.js",
        "card.js",
        "panel.js",
        "ui.js",
        "auto.js",
        "logs.js",
        "reddit.js",
        "health.js",
        "campaign.js",
        "evidence-view.js",
        "quick-toast.js",
        "quick-resolve.js",
        "quick-sites.js",
        "quick-stream.js",
        "quick-gif.js",
        "quick-save.js",
        "quick-copy.js",
        "quick-text.js",
        "yt-reference.js",
        "quick-inline.js",
        "quick-hover-ui.js",
        "quick-hover.js",
        "content.js"
      ],
      "css": [
        "badges.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "yt-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "radar@harperz9.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent",
          "browsingActivity"
        ]
      },
      "strict_min_version": "121.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Daylight Commons",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/radar-16.png",
      "32": "icons/radar-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": false,
        "path": "rules/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": false,
        "path": "rules/easyprivacy.json"
      }
    ]
  },
  "commands": {
    "save-media": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the picture or video under the pointer"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Daylight Commons",
    "open_at_install": false
  }
}
