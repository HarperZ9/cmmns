{
  "manifest_version": 3,
  "name": "Radar",
  "version": "2.1.0",
  "description": "Free, no account, nothing leaves your browser unless you opt in. Sourced evidence on posts and links, each sign with its error rate.",
  "homepage_url": "https://github.com/HarperZ9/radar",
  "icons": {
    "16": "icons/radar-16.png",
    "32": "icons/radar-32.png",
    "48": "icons/radar-48.png",
    "128": "icons/radar-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://bsky.app/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "core.bundle.js",
      "lifecycle.js",
      "instances.js",
      "packs-bg.js",
      "sources-bg.js",
      "evidence-bg.js",
      "ocr.bundle.js",
      "ocr-bg.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "sniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ytsniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "bskysniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "fedisniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://bsky.app/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "core.bundle.js",
        "settings.js",
        "fonts.js",
        "store.js",
        "feedback.js",
        "meta.js",
        "about-page.js",
        "platforms-reach.js",
        "platforms.js",
        "tour.js",
        "pop.js",
        "media.js",
        "mediacard.js",
        "linkcard.js",
        "signals.js",
        "card.js",
        "panel.js",
        "ui.js",
        "auto.js",
        "logs.js",
        "reddit.js",
        "health.js",
        "campaign.js",
        "evidence-view.js",
        "content.js"
      ],
      "css": [
        "badges.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "radar@harperz9.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "121.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/radar-16.png",
      "32": "icons/radar-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
