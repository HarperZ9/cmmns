{
  "manifest_version": 3,
  "name": "Radar",
  "version": "1.0.0",
  "description": "Evidence on social media replies: where an account is labelled as based, signs of coordination, and a thread report. Nothing leaves your browser.",
  "icons": {
    "16": "icons/radar-16.png",
    "32": "icons/radar-32.png",
    "48": "icons/radar-48.png",
    "128": "icons/radar-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://bsky.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "core.bundle.js",
      "lifecycle.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "sniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ytsniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "bskysniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://bsky.app/*"
      ],
      "js": [
        "core.bundle.js",
        "settings.js",
        "store.js",
        "meta.js",
        "about-page.js",
        "platforms.js",
        "pop.js",
        "signals.js",
        "card.js",
        "panel.js",
        "ui.js",
        "auto.js",
        "logs.js",
        "reddit.js",
        "content.js"
      ],
      "css": [
        "badges.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "radar@local",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/radar-16.png",
      "32": "icons/radar-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
